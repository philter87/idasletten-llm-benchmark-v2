@page
@model Idasletten.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <svg class="hero-bg" viewBox="0 0 1200 340" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2b2320"/>
                <stop offset="0.55" stop-color="#5a3a2e"/>
                <stop offset="1" stop-color="#8c4a32"/>
            </linearGradient>
            <linearGradient id="ground" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#6d2f24"/>
                <stop offset="1" stop-color="#3a1a14"/>
            </linearGradient>
        </defs>
        <rect width="1200" height="340" fill="url(#sky)"/>
        <!-- gate of Valhalla -->
        <g fill="#1c1310">
            <rect x="930" y="60" width="26" height="220"/>
            <rect x="1030" y="60" width="26" height="220"/>
            <path d="M910 70 L1076 70 L1066 40 L920 40 Z"/>
            <rect x="900" y="120" width="190" height="16"/>
            <rect x="900" y="180" width="190" height="12"/>
        </g>
        <!-- aurora streaks -->
        <g opacity="0.5">
            <path d="M0 60 C 200 20, 420 90, 700 40 S 1100 70, 1200 30" stroke="#8fd3c7" stroke-width="10" fill="none" opacity="0.35"/>
            <path d="M0 95 C 240 55, 460 120, 760 70 S 1120 100, 1200 60" stroke="#e8b48a" stroke-width="7" fill="none" opacity="0.3"/>
        </g>
        <!-- battle field -->
        <rect y="240" width="1200" height="100" fill="url(#ground)"/>
        <!-- silhouettes -->
        <g fill="#120c0a">
            <g transform="translate(120 200)">
                <circle cx="0" cy="0" r="9"/>
                <path d="M-8 8 L8 8 L12 60 L-12 60 Z"/>
                <rect x="10" y="18" width="34" height="4" transform="rotate(35 10 18)"/>
            </g>
            <g transform="translate(330 210) scale(-1 1)">
                <circle cx="0" cy="0" r="9"/>
                <path d="M-8 8 L8 8 L12 60 L-12 60 Z"/>
                <path d="M14 10 L44 2 L40 14 Z"/>
            </g>
            <g transform="translate(520 198)">
                <circle cx="0" cy="0" r="9"/>
                <path d="M-8 8 L8 8 L12 60 L-12 60 Z"/>
                <rect x="-30" y="20" width="4" height="36"/>
                <circle cx="-28" cy="18" r="7" fill="none" stroke="#120c0a" stroke-width="4"/>
            </g>
            <g transform="translate(700 208) scale(-1 1)">
                <circle cx="0" cy="0" r="9"/>
                <path d="M-8 8 L8 8 L12 60 L-12 60 Z"/>
                <rect x="12" y="16" width="40" height="4" transform="rotate(-25 12 16)"/>
            </g>
            <g transform="translate(860 204)">
                <circle cx="0" cy="0" r="9"/>
                <path d="M-8 8 L8 8 L12 60 L-12 60 Z"/>
                <path d="M12 8 L40 20 L12 26 Z"/>
            </g>
        </g>
        <!-- rune band -->
        <g fill="#f5f0e8" opacity="0.28" font-size="22" font-family="serif" letter-spacing="14">
            <text x="40" y="322">ᚠ ᚢ ᚦ ᚨ ᚱ ᚲ ᚷ ᚹ ᚺ ᚾ ᛁ ᛃ ᛇ ᛈ ᛉ ᛋ ᛏ ᛒ ᛖ ᛗ ᛚ ᛜ ᛞ ᛟ</text>
        </g>
    </svg>
    <div class="hero-content">
        <h1>Idasletten</h1>
        <blockquote>
            »Idasletten (Iðavöllr) findes i nordisk mytologi lige uden for Valhals porte. Det er her
            vikingerne som er døde i krig udkæmper deres drabelige slag hver dag, som øvelse til
            Ragnarok. Hver aften er Idasletten rød af blod.«
        </blockquote>
    </div>
</div>

<div class="page-title-row">
    <div>
        <h2 style="margin:0">Public tournaments</h2>
        <p class="muted" style="margin:.25rem 0 0">Open battle fields — pick one and join the fight.</p>
    </div>
    <a class="btn" data-variant="outline" asp-page="/Tournaments/Create">New tournament</a>
</div>

@if (Model.Tournaments.Count == 0)
{
    <div class="card">
        <div class="empty" style="padding:1.5rem">
            <p>No public tournaments yet. Be the first to raise a banner.</p>
        </div>
    </div>
}
else
{
    <div class="card-row">
        @foreach (var t in Model.Tournaments)
        {
            <div class="card">
                <a class="tournament-card" asp-page="/Tournaments/Details" asp-route-id="@t.Id">
                    <div class="card-header">
                        <h3 class="card-title">@t.Name</h3>
                        <div class="card-action">
                            <span class="badge" data-variant="secondary">@t.ScoreSystem</span>
                        </div>
                    </div>
                    <div class="card-content">
                        <p class="muted small">
                            Teams of @t.TeamSize · to @t.PointsToWin points · @t.PlayerCount player(s)
                        </p>
                    </div>
                </a>
            </div>
        }
    </div>
}

<p style="margin-top:.75rem">
    <a class="muted small" asp-page="/Tournaments/Index">View historical tournaments (archived &amp; private) →</a>
</p>
