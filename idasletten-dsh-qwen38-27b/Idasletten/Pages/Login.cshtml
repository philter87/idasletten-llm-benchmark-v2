@page
@model Idasletten.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    var returnParam = string.IsNullOrEmpty(Model.ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
}

<div style="max-width:440px;margin:2rem auto">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title" style="font-size:1.4rem">Sign in</h2>
            <p class="card-description">
                Logging in is only needed to create tournaments and edit completed matches.
            </p>
        </div>
        <div class="card-content" style="display:flex;flex-direction:column;gap:1rem">
            @if (Model.AzureAdEnabled)
            {
                <form method="post" asp-page-handler="Microsoft">
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn" data-variant="outline" data-size="lg" style="width:100%;justify-content:center">
                        <svg width="18" height="18" viewBox="0 0 21 21" aria-hidden="true" style="margin-right:.5rem">
                            <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                            <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                            <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                            <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                        </svg>
                        Sign in with Microsoft
                    </button>
                </form>
            }
            else
            {
                <p class="muted small">
                    Azure AD is not configured (set AzureAd:ClientId in the environment).
                    @(Model.TestUserEnabled ? "Use the test login below." : "")
                </p>
            }

            @if (Model.TestUserEnabled)
            {
                <div style="border-top:1px solid #f4f4f5;padding-top:1rem;display:flex;flex-direction:column;gap:.75rem">
                    <p class="muted small" style="margin:0">Test-only login (enabled via TestUser__Email / TestUser__Password):</p>
                    <form method="post" asp-page-handler="TestLogin" style="display:flex;flex-direction:column;gap:.75rem">
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <div class="field">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" class="input" type="email" required autocomplete="username" />
                        </div>
                        <div class="field">
                            <label asp-for="Password">Password</label>
                            <input asp-for="Password" class="input" type="password" required autocomplete="current-password" />
                        </div>
                        <button type="submit" class="btn" data-size="lg">Sign in (test user)</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
