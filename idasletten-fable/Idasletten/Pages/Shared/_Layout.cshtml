<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title} — Idasletten" : "Idasletten")</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.1/dist/basecoat.cdn.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.1/dist/js/all.min.js" defer></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="brand" href="/">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 17.5 3 6V3h3l11.5 11.5"/><path d="M13 19l6-6"/><path d="M16 16l4 4"/><path d="M19 21l2-2"/><path d="M9.5 6.5 21 18v3h-3L6.5 9.5"/><path d="M5 14l4 4"/><path d="M3 21l2-2"/></svg>
                Idasletten
            </a>
            <div class="nav-links">
                <a href="/">Hjem</a>
                <a href="/tournaments">Turneringer</a>
            </div>
            <div class="nav-auth">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-user">@User.Identity.Name</span>
                    <form method="post" action="/logout">
                        <button type="submit" class="btn" data-variant="outline" data-size="sm">Log ud</button>
                    </form>
                }
                else
                {
                    <a class="btn" data-variant="outline" data-size="sm" href="/login">Log ind</a>
                }
            </div>
        </nav>
    </header>
    <main class="site-main">
        @if (TempData["Error"] is string error)
        {
            <div class="alert" data-variant="destructive" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                <h2>Der opstod en fejl</h2>
                <section>@error</section>
            </div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>Idasletten — Iðavöllr · Her øver einherjerne sig til Ragnarok</span>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
