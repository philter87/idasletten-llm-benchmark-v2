<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Idasletten</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@0.3.4/dist/basecoat.cdn.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav-shell" aria-label="Hovedmenu">
            <a class="brand" asp-page="/Index"><span class="brand-mark">ᛁ</span> Idasletten</a>
            <div class="nav-links">
                <a asp-page="/Index">Hjem</a>
                <a asp-page="/Tournaments/Index">Turneringer</a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="link-button">Log ud</button></form>
                }
                else
                {
                    <a class="button button-small" asp-page="/Login">Log ind</a>
                }
            </div>
        </nav>
    </header>
    <main class="page-shell">@RenderBody()</main>
    <footer>Idasletten · øvelse før Ragnarok</footer>
    <script src="https://cdn.jsdelivr.net/npm/basecoat-css@0.3.4/dist/js/basecoat.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
