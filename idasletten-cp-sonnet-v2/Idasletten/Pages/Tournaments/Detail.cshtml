@page "/tournaments/{tournamentId}"
@model Idasletten.Pages.Tournaments.DetailModel
@{
    ViewData["Title"] = Model.Tournament?.Name ?? "Tournament";
}

@if (Model.Tournament == null)
{
    <p>Tournament not found.</p>
    return;
}

<div style="display: flex; gap: 2rem; align-items: flex-start;">
    <!-- Main Content -->
    <div style="flex: 1; min-width: 0;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
            <div>
                <h1 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 0.25rem;">@Model.Tournament.Name</h1>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <span style="background: #f3f4f6; border-radius: 9999px; padding: 0.2rem 0.65rem; font-size: 0.75rem; color: #374151;">@Model.Tournament.ScoreSystem</span>
                    <span style="background: #f3f4f6; border-radius: 9999px; padding: 0.2rem 0.65rem; font-size: 0.75rem; color: #374151;">First to @Model.Tournament.PointsToWin</span>
                    <span style="background: #f3f4f6; border-radius: 9999px; padding: 0.2rem 0.65rem; font-size: 0.75rem; color: #374151;">@Model.Tournament.TeamSize v @Model.Tournament.TeamSize</span>
                </div>
            </div>
        </div>

        <!-- Scoreboard -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <h2 style="font-size: 1.1rem; font-weight: 600;">Scoreboard</h2>
            <button onclick="document.getElementById('addPlayerDialog').showModal()"
                    style="background: #fff; color: #111; padding: 0.4rem 0.875rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 500; cursor: pointer;">
                + Add Player
            </button>
        </div>

        <div style="border: 1px solid #e5e7eb; border-radius: 0.75rem; overflow: hidden; margin-bottom: 2rem;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                        <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">#</th>
                        <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Player</th>
                        <th style="padding: 0.625rem 1rem; text-align: right; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Score</th>
                        <th style="padding: 0.625rem 1rem; text-align: right; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">W</th>
                        <th style="padding: 0.625rem 1rem; text-align: right; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">L</th>
                        <th style="padding: 0.625rem 1rem; text-align: right; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Matches</th>
                        @if (Model.Tournament.ScoreSystem == Idasletten.Shared.Entities.ScoreSystem.Lives)
                        {
                            <th style="padding: 0.625rem 1rem; text-align: right; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Lives</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{int rank = 1;}
                    @foreach (var player in Model.Tournament.Players.OrderByDescending(p => p.Score).ThenByDescending(p => p.WinCount))
                    {
                        <tr style="border-bottom: 1px solid #f3f4f6;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                            <td style="padding: 0.75rem 1rem; color: #9ca3af; font-size: 0.875rem;">@rank</td>
                            <td style="padding: 0.75rem 1rem;">
                                <a href="/users/@player.UserId" style="font-weight: 600; color: #111; text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
                                    @if (!string.IsNullOrEmpty(player.User.ImageUrl))
                                    {
                                        <img src="@player.User.ImageUrl" alt="" style="width: 1.5rem; height: 1.5rem; border-radius: 9999px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span style="width: 1.5rem; height: 1.5rem; border-radius: 9999px; background: #e5e7eb; display: inline-flex; align-items: center; justify-content: center; font-size: 0.625rem; font-weight: 700; color: #6b7280;">@player.User.Username.Substring(0, Math.Min(2, player.User.Username.Length))</span>
                                    }
                                    @player.User.Username
                                    @if (!string.IsNullOrEmpty(player.User.Name) && player.User.Name != player.User.Username)
                                    {
                                        <span style="font-weight: 400; color: #6b7280; font-size: 0.8rem;">@player.User.Name</span>
                                    }
                                </a>
                            </td>
                            <td style="padding: 0.75rem 1rem; text-align: right; font-weight: 600;">
                                @player.Score.ToString("F0")
                                @if (player.ScoreDiff != 0)
                                {
                                    <span style="font-size: 0.7rem; font-weight: 400; color: @(player.ScoreDiff > 0 ? "#059669" : "#dc2626"); margin-left: 0.25rem;">
                                        @(player.ScoreDiff > 0 ? "+" : "")@player.ScoreDiff.ToString("F0")
                                    </span>
                                }
                            </td>
                            <td style="padding: 0.75rem 1rem; text-align: right; color: #059669; font-weight: 500;">@player.WinCount</td>
                            <td style="padding: 0.75rem 1rem; text-align: right; color: #dc2626; font-weight: 500;">@player.LoseCount</td>
                            <td style="padding: 0.75rem 1rem; text-align: right; color: #6b7280;">@player.MatchCount</td>
                            @if (Model.Tournament.ScoreSystem == Idasletten.Shared.Entities.ScoreSystem.Lives)
                            {
                                <td style="padding: 0.75rem 1rem; text-align: right;">
                                    @for (int i = 0; i < player.Lives; i++) { <span>❤️</span> }
                                    @for (int i = player.Lives; i < 3; i++) { <span style="opacity:0.3;">💀</span> }
                                </td>
                            }
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right Column -->
    <div style="width: 280px; flex-shrink: 0; display: flex; flex-direction: column; gap: 1rem;">
        <a href="/tournaments/@Model.Tournament.Id/create-match"
           style="background: #111; color: #fff; padding: 0.75rem 1rem; border-radius: 0.5rem; text-decoration: none; font-size: 0.875rem; font-weight: 600; text-align: center; display: block;">
            ⚡ Create Match
        </a>

        <!-- Planned Matches -->
        @if (Model.PlannedMatches.Any())
        {
            <div style="border: 1px solid #e5e7eb; border-radius: 0.75rem; overflow: hidden;">
                <div style="padding: 0.75rem 1rem; background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <h3 style="font-size: 0.875rem; font-weight: 600; margin: 0;">Upcoming Matches</h3>
                </div>
                @foreach (var match in Model.PlannedMatches)
                {
                    <a href="/tournaments/@Model.Tournament.Id/create-match?matchId=@match.Id"
                       style="display: block; padding: 0.625rem 1rem; border-bottom: 1px solid #f3f4f6; text-decoration: none; color: #111; font-size: 0.8rem;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                        @{
                            var t1 = match.TeamResults.FirstOrDefault();
                            var t2 = match.TeamResults.Skip(1).FirstOrDefault();
                            var t1Names = t1?.Team.TeamPlayers.Select(tp => tp.Player.User.Username) ?? [];
                            var t2Names = t2?.Team.TeamPlayers.Select(tp => tp.Player.User.Username) ?? [];
                        }
                        <span style="font-weight: 500;">@string.Join(", ", t1Names)</span>
                        <span style="color: #9ca3af;"> vs </span>
                        <span style="font-weight: 500;">@string.Join(", ", t2Names)</span>
                    </a>
                }
            </div>
        }

        <!-- Recent Matches -->
        @if (Model.RecentMatches.Any())
        {
            <div style="border: 1px solid #e5e7eb; border-radius: 0.75rem; overflow: hidden;">
                <div style="padding: 0.75rem 1rem; background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                    <h3 style="font-size: 0.875rem; font-weight: 600; margin: 0;">Recent Results</h3>
                </div>
                @foreach (var match in Model.RecentMatches)
                {
                    <a href="/tournaments/@Model.Tournament.Id/matches/@match.Id"
                       style="display: block; padding: 0.625rem 1rem; border-bottom: 1px solid #f3f4f6; text-decoration: none; color: #111; font-size: 0.8rem;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                        @{
                            var r1 = match.TeamResults.FirstOrDefault();
                            var r2 = match.TeamResults.Skip(1).FirstOrDefault();
                            if (r1 != null && r2 != null)
                            {
                                var names1 = r1.Team.TeamPlayers.Select(tp => tp.Player.User.Username);
                                var names2 = r2.Team.TeamPlayers.Select(tp => tp.Player.User.Username);
                                <span style="font-weight: 500;">@string.Join(", ", names1)</span>
                                <span style="color: #9ca3af;"> @r1.GoalsWon–@r2.GoalsWon </span>
                                <span style="font-weight: 500;">@string.Join(", ", names2)</span>
                            }
                        }
                    </a>
                }
            </div>
        }

        <a href="/tournaments/@Model.Tournament.Id/matches" style="color: #6b7280; font-size: 0.8rem; text-decoration: none; text-align: center;">
            View all matches →
        </a>
    </div>
</div>

<!-- Add Player Dialog -->
<dialog id="addPlayerDialog" style="border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.5rem; min-width: 380px; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
    <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">Add Player</h3>
    <form method="post" asp-page-handler="AddPlayer">
        <input type="hidden" name="tournamentId" value="@Model.Tournament.Id" />
        <div style="margin-bottom: 1rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Initials / Username</label>
            <input name="username" type="text" placeholder="e.g. PCH" required maxlength="10"
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; box-sizing: border-box;" />
        </div>
        <div style="margin-bottom: 1.25rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Name <span style="color: #9ca3af; font-weight: 400;">(optional)</span></label>
            <input name="name" type="text" placeholder="Full name"
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; box-sizing: border-box;" />
        </div>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" onclick="document.getElementById('addPlayerDialog').close()"
                    style="padding: 0.5rem 1rem; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #fff; cursor: pointer; font-size: 0.875rem;">
                Cancel
            </button>
            <button type="submit" style="padding: 0.5rem 1rem; background: #111; color: #fff; border: none; border-radius: 0.5rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">
                Add Player
            </button>
        </div>
    </form>
</dialog>
