@page "/tournaments/{tournamentId}/matches"
@model Idasletten.Pages.Tournaments.MatchesModel
@{
    ViewData["Title"] = "Matches";
}

<div style="margin-bottom: 1.5rem;">
    <a href="/tournaments/@Model.TournamentId" style="color: #6b7280; font-size: 0.875rem; text-decoration: none;">← Back to @(Model.Tournament?.Name ?? "tournament")</a>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h1 style="font-size: 1.75rem; font-weight: 700;">Matches</h1>
    <div style="display: flex; gap: 0.5rem;">
        <button onclick="document.getElementById('addPlannedDialog').showModal()"
                style="background: #fff; color: #111; padding: 0.5rem 0.875rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 500; cursor: pointer;">
            + Add planned match
        </button>
        <button onclick="document.getElementById('planSeveralDialog').showModal()"
                style="background: #111; color: #fff; padding: 0.5rem 0.875rem; border: none; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 500; cursor: pointer;">
            📅 Plan several matches
        </button>
    </div>
</div>

<!-- Planned Matches -->
<section style="margin-bottom: 2.5rem;">
    <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem;">Planned Matches</h2>
    @if (!Model.PlannedMatches.Any())
    {
        <p style="color: #9ca3af; font-size: 0.875rem;">No planned matches.</p>
    }
    else
    {
        <div style="border: 1px solid #e5e7eb; border-radius: 0.75rem; overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                        <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">#</th>
                        <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Teams</th>
                        <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in Model.PlannedMatches)
                    {
                        <tr style="border-bottom: 1px solid #f3f4f6;">
                            <td style="padding: 0.75rem 1rem; color: #9ca3af; font-size: 0.875rem;">@match.Order</td>
                            <td style="padding: 0.75rem 1rem; font-size: 0.875rem;">
                                @{
                                    var t1 = match.TeamResults.FirstOrDefault();
                                    var t2 = match.TeamResults.Skip(1).FirstOrDefault();
                                }
                                <span style="font-weight: 500;">@string.Join(", ", t1?.Team.TeamPlayers.Select(tp => tp.Player.User.Username) ?? [])</span>
                                <span style="color: #9ca3af;"> vs </span>
                                <span style="font-weight: 500;">@string.Join(", ", t2?.Team.TeamPlayers.Select(tp => tp.Player.User.Username) ?? [])</span>
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <a href="/tournaments/@Model.TournamentId/create-match?matchId=@match.Id"
                                   style="color: #111; font-size: 0.8rem; font-weight: 500; text-decoration: none; padding: 0.3rem 0.625rem; border: 1px solid #d1d5db; border-radius: 0.375rem;">
                                    Record result
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<!-- Match Results -->
<section>
    <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem;">Match Results</h2>
    @if (!Model.CompletedMatches.Any())
    {
        <p style="color: #9ca3af; font-size: 0.875rem;">No completed matches yet.</p>
    }
    else
    {
        <div style="border: 1px solid #e5e7eb; border-radius: 0.75rem; overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                        <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Match</th>
                        <th style="padding: 0.625rem 1rem; text-align: center; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Score</th>
                        <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in Model.CompletedMatches)
                    {
                        var r1 = match.TeamResults.FirstOrDefault();
                        var r2 = match.TeamResults.Skip(1).FirstOrDefault();
                        if (r1 == null || r2 == null) continue;
                        bool t1Won = r1.GoalsWon > r2.GoalsWon;
                        <tr style="border-bottom: 1px solid #f3f4f6;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                            <td style="padding: 0.75rem 1rem; font-size: 0.875rem;">
                                <span style="font-weight: @(t1Won ? "600" : "400");">@string.Join(", ", r1.Team.TeamPlayers.Select(tp => tp.Player.User.Username))</span>
                                <span style="color: #9ca3af;"> vs </span>
                                <span style="font-weight: @(!t1Won ? "600" : "400");">@string.Join(", ", r2.Team.TeamPlayers.Select(tp => tp.Player.User.Username))</span>
                            </td>
                            <td style="padding: 0.75rem 1rem; text-align: center; font-weight: 700; font-size: 1rem;">
                                <span style="color: @(t1Won ? "#059669" : "#374151");">@r1.GoalsWon</span>
                                <span style="color: #9ca3af; margin: 0 0.25rem;">–</span>
                                <span style="color: @(!t1Won ? "#059669" : "#374151");">@r2.GoalsWon</span>
                            </td>
                            <td style="padding: 0.75rem 1rem; color: #6b7280; font-size: 0.8rem;">
                                @match.PlayedAt?.ToString("MMM d, HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<!-- Add Planned Match Dialog -->
<dialog id="addPlannedDialog" style="border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.5rem; min-width: 400px; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
    <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">Add Planned Match</h3>
    <form method="post" asp-page-handler="AddPlanned">
        <input type="hidden" name="tournamentId" value="@Model.TournamentId" />
        <div style="margin-bottom: 0.875rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Team 1 initials</label>
            <input name="team1Initials" type="text" placeholder="PCH, MKR" required
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; box-sizing: border-box;" />
        </div>
        <div style="margin-bottom: 1.25rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Team 2 initials</label>
            <input name="team2Initials" type="text" placeholder="JLN, ABN" required
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; box-sizing: border-box;" />
        </div>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" onclick="document.getElementById('addPlannedDialog').close()" style="padding: 0.5rem 1rem; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #fff; cursor: pointer; font-size: 0.875rem;">Cancel</button>
            <button type="submit" style="padding: 0.5rem 1rem; background: #111; color: #fff; border: none; border-radius: 0.5rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">Add Match</button>
        </div>
    </form>
</dialog>

<!-- Plan Several Matches Dialog -->
<dialog id="planSeveralDialog" style="border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.5rem; min-width: 440px; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
    <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">Plan Several Matches</h3>
    <form method="post" asp-page-handler="PlanSeveral">
        <input type="hidden" name="tournamentId" value="@Model.TournamentId" />

        <div style="margin-bottom: 0.875rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Games per player</label>
            <input name="gamesPerPlayer" type="number" min="1" max="20" value="2"
                   style="width: 100px; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem;" />
        </div>

        <div style="margin-bottom: 0.875rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Seeding type</label>
            <select name="seedingType" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; background: #fff;">
                <option value="Random">Random</option>
                <option value="Equality">Equality (best vs worst: 1+N, 2+(N-1)...)</option>
                <option value="Fair">Fair (top half vs bottom half)</option>
            </select>
        </div>

        <div style="margin-bottom: 0.875rem; display: flex; align-items: center; gap: 0.75rem;">
            <input name="fixedTeams" type="checkbox" id="fixedTeams" style="width: 1rem; height: 1rem;" />
            <label for="fixedTeams" style="font-size: 0.875rem; font-weight: 500; cursor: pointer;">Fixed teams (don't reshuffle)</label>
        </div>

        @if (Model.AllTournaments.Any())
        {
            <div style="margin-bottom: 0.875rem;">
                <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Seed from tournament <span style="color: #9ca3af; font-weight: 400;">(optional)</span></label>
                <select name="seedTournamentId" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; background: #fff;">
                    <option value="">-- None --</option>
                    @foreach (var t in Model.AllTournaments)
                    {
                        <option value="@t.Id" selected="@(t.Id == Model.Tournament?.SeedTournamentId)">@t.Name</option>
                    }
                </select>
            </div>
        }

        <div style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1.25rem;">
            <button type="button" onclick="document.getElementById('planSeveralDialog').close()" style="padding: 0.5rem 1rem; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #fff; cursor: pointer; font-size: 0.875rem;">Cancel</button>
            <button type="submit" style="padding: 0.5rem 1rem; background: #111; color: #fff; border: none; border-radius: 0.5rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">Plan Matches</button>
        </div>
    </form>
</dialog>
