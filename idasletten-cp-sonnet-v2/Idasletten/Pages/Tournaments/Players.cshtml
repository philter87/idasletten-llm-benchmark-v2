@page "/tournaments/{tournamentId}/players"
@model Idasletten.Pages.Tournaments.PlayersModel
@{
    ViewData["Title"] = "Players";
}

<div style="margin-bottom: 1.5rem;">
    <a href="/tournaments/@Model.TournamentId" style="color: #6b7280; font-size: 0.875rem; text-decoration: none;">← Back to @(Model.Tournament?.Name ?? "tournament")</a>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h1 style="font-size: 1.75rem; font-weight: 700;">Players</h1>
    <button onclick="document.getElementById('addPlayerDialog').showModal()"
            style="background: #111; color: #fff; padding: 0.5rem 0.875rem; border: none; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 500; cursor: pointer;">
        + Add player
    </button>
</div>

<!-- Players Table -->
<div style="border: 1px solid #e5e7eb; border-radius: 0.75rem; overflow: hidden; margin-bottom: 2rem;">
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Username</th>
                <th style="padding: 0.625rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Name</th>
                <th style="padding: 0.625rem 1rem; text-align: right; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">Score</th>
                <th style="padding: 0.625rem 1rem; text-align: right; font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase;">W/L</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var player in Model.Players.OrderByDescending(p => p.Score))
            {
                <tr style="border-bottom: 1px solid #f3f4f6;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                    <td style="padding: 0.75rem 1rem;">
                        <a href="/users/@player.UserId" style="font-weight: 600; color: #111; text-decoration: none;">@player.User.Username</a>
                    </td>
                    <td style="padding: 0.75rem 1rem; color: #6b7280; font-size: 0.875rem;">@player.User.Name</td>
                    <td style="padding: 0.75rem 1rem; text-align: right; font-weight: 600;">@player.Score.ToString("F0")</td>
                    <td style="padding: 0.75rem 1rem; text-align: right; font-size: 0.875rem;">
                        <span style="color: #059669;">@player.WinCount</span>/<span style="color: #dc2626;">@player.LoseCount</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Add from previous tournament -->
@if (Model.AllTournaments.Any())
{
    <section style="border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.25rem;">
        <h3 style="font-size: 0.875rem; font-weight: 600; margin-bottom: 0.875rem;">Add players from a previous tournament</h3>
        @if (Model.SeedTournament != null)
        {
            <p style="font-size: 0.875rem; color: #6b7280; margin-bottom: 0.75rem;">Based on: <strong>@Model.SeedTournament.Name</strong></p>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                @foreach (var seedPlayer in Model.SeedTournamentPlayers)
                {
                    bool alreadyAdded = Model.Players.Any(p => p.UserId == seedPlayer.UserId);
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0; @(alreadyAdded ? "opacity: 0.5;" : "")">
                        <div>
                            <span style="font-weight: 500; @(alreadyAdded ? "text-decoration: line-through;" : "")">@seedPlayer.User.Username</span>
                            <span style="color: #6b7280; font-size: 0.8rem; margin-left: 0.5rem;">@seedPlayer.User.Name</span>
                            <span style="color: #9ca3af; font-size: 0.75rem; margin-left: 0.5rem;">Score: @seedPlayer.Score.ToString("F0")</span>
                        </div>
                        @if (!alreadyAdded)
                        {
                            <form method="post" asp-page-handler="AddFromSeed" style="display: inline;">
                                <input type="hidden" name="tournamentId" value="@Model.TournamentId" />
                                <input type="hidden" name="username" value="@seedPlayer.User.Username" />
                                <input type="hidden" name="name" value="@seedPlayer.User.Name" />
                                <button type="submit" style="background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.25rem 0.625rem; cursor: pointer; font-size: 0.8rem;">+</button>
                            </form>
                        }
                        else
                        {
                            <span style="color: #059669; font-size: 0.8rem;">✓ Added</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div>
                <p style="font-size: 0.875rem; color: #6b7280; margin-bottom: 0.5rem;">Select a tournament to import players from:</p>
                @foreach (var t in Model.AllTournaments)
                {
                    <form method="post" asp-page-handler="SetSeed" style="display: inline; margin-right: 0.5rem; margin-bottom: 0.5rem;">
                        <input type="hidden" name="tournamentId" value="@Model.TournamentId" />
                        <input type="hidden" name="seedTournamentId" value="@t.Id" />
                        <button type="submit" style="background: #fff; border: 1px solid #d1d5db; border-radius: 0.5rem; padding: 0.375rem 0.75rem; cursor: pointer; font-size: 0.8rem; font-weight: 500;">
                            @t.Name
                        </button>
                    </form>
                }
            </div>
        }
    </section>
}

<!-- Add Player Dialog -->
<dialog id="addPlayerDialog" style="border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 1.5rem; min-width: 380px; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
    <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">Add Player</h3>
    <form method="post" asp-page-handler="AddPlayer">
        <input type="hidden" name="tournamentId" value="@Model.TournamentId" />
        <div style="margin-bottom: 0.875rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Initials / Username</label>
            <input name="username" type="text" placeholder="e.g. PCH" required maxlength="10"
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; box-sizing: border-box;" />
        </div>
        <div style="margin-bottom: 1.25rem;">
            <label style="font-size: 0.875rem; font-weight: 500; display: block; margin-bottom: 0.375rem;">Name <span style="color: #9ca3af; font-weight: 400;">(optional)</span></label>
            <input name="name" type="text" placeholder="Full name"
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; box-sizing: border-box;" />
        </div>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" onclick="document.getElementById('addPlayerDialog').close()" style="padding: 0.5rem 1rem; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #fff; cursor: pointer; font-size: 0.875rem;">Cancel</button>
            <button type="submit" style="padding: 0.5rem 1rem; background: #111; color: #fff; border: none; border-radius: 0.5rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">Add Player</button>
        </div>
    </form>
</dialog>
