@page
@model Idasletten.Pages.Tournaments.CreateModel
@{
    ViewData["Title"] = "Create Tournament";
}

<div style="max-width: 560px; margin: 0 auto;">
    <h1 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem;">Create Tournament</h1>

    <form method="post" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div asp-validation-summary="ModelOnly" style="color: #dc2626; font-size: 0.875rem;"></div>

        <div>
            <label asp-for="Input.Name" style="font-weight: 500; font-size: 0.875rem; display: block; margin-bottom: 0.375rem;">Tournament Name</label>
            <input asp-for="Input.Name" type="text" placeholder="e.g. Valhalla Open 2025"
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; outline: none;" />
            <span asp-validation-for="Input.Name" style="color: #dc2626; font-size: 0.75rem;"></span>
        </div>

        <div style="display: flex; gap: 1rem;">
            <div style="flex: 1;">
                <label asp-for="Input.TeamSize" style="font-weight: 500; font-size: 0.875rem; display: block; margin-bottom: 0.375rem;">Team Size</label>
                <input asp-for="Input.TeamSize" type="number" min="1" max="10"
                       style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem;" />
            </div>
            <div style="flex: 1;">
                <label asp-for="Input.PointsToWin" style="font-weight: 500; font-size: 0.875rem; display: block; margin-bottom: 0.375rem;">Points to Win</label>
                <input asp-for="Input.PointsToWin" type="number" min="1" max="99"
                       style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem;" />
            </div>
        </div>

        <div>
            <label asp-for="Input.MaxPlayerCount" style="font-weight: 500; font-size: 0.875rem; display: block; margin-bottom: 0.375rem;">
                Max Players <span style="color: #9ca3af; font-weight: 400;">(optional)</span>
            </label>
            <input asp-for="Input.MaxPlayerCount" type="number" min="2" placeholder="No limit"
                   style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem;" />
        </div>

        <div>
            <label asp-for="Input.ScoreSystem" style="font-weight: 500; font-size: 0.875rem; display: block; margin-bottom: 0.375rem;">
                Score System
                <span title="Elo: rating based on win/loss probability. TrueSkill: Bayesian system. Lives: lose a life per loss. WinCount: total wins."
                      style="cursor: help; color: #9ca3af; margin-left: 0.25rem;">ⓘ</span>
            </label>
            <select asp-for="Input.ScoreSystem" asp-items="Model.ScoreSystemOptions"
                    style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; background: #fff;">
            </select>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <input asp-for="Input.IsPublic" type="checkbox"
                   style="width: 1rem; height: 1rem; cursor: pointer;" />
            <label asp-for="Input.IsPublic" style="font-weight: 500; font-size: 0.875rem; cursor: pointer;">Public tournament</label>
        </div>

        <div style="display: flex; gap: 0.75rem; padding-top: 0.5rem;">
            <button type="submit" style="background: #111; color: #fff; padding: 0.625rem 1.25rem; border: none; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 500; cursor: pointer;">
                Create Tournament
            </button>
            <button type="submit" name="createAndPlan" value="true" style="background: #fff; color: #111; padding: 0.625rem 1.25rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 500; cursor: pointer;">
                Create &amp; Plan Matches →
            </button>
        </div>
    </form>
</div>
