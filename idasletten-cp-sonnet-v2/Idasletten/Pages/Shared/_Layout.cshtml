<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Idasletten</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@latest/dist/basecoat.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background: #fff; font-family: 'Inter', sans-serif;">
    <nav style="border-bottom: 1px solid #e5e7eb; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; background: #fff;">
        <div style="display: flex; align-items: center; gap: 2rem;">
            <a asp-page="/Index" style="font-weight: 700; font-size: 1.25rem; color: #111; text-decoration: none;">⚡ Idasletten</a>
            <div style="display: flex; gap: 1rem;">
                <a asp-page="/Index" style="color: #555; text-decoration: none; font-size: 0.875rem;">Home</a>
                <a asp-page="/Tournaments/Index" style="color: #555; text-decoration: none; font-size: 0.875rem;">Tournaments</a>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span style="font-size: 0.875rem; color: #555;">@User.Identity.Name</span>
                <a asp-page="/Account/Logout" style="font-size: 0.875rem; color: #555; text-decoration: none;">Sign out</a>
            }
            else
            {
                <a asp-page="/Login" style="font-size: 0.875rem; color: #555; text-decoration: none;">Sign in</a>
            }
        </div>
    </nav>

    <div style="max-width: 1280px; margin: 0 auto; padding: 1.5rem;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer style="border-top: 1px solid #e5e7eb; padding: 1rem 1.5rem; text-align: center; color: #9ca3af; font-size: 0.75rem; margin-top: 3rem;">
        <p>Idasletten &mdash; Vikingernes kampplads &copy; @DateTime.Now.Year</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/basecoat-css@latest/dist/basecoat.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
