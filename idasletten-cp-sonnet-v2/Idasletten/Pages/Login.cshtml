@page
@model Idasletten.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div style="max-width: 400px; margin: 4rem auto; text-align: center;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚡</div>
    <h1 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem;">Sign in to Idasletten</h1>
    <p style="color: #6b7280; font-size: 0.875rem; margin-bottom: 2rem;">Login required to create tournaments and edit completed matches.</p>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <a href="/signin-oidc-challenge" style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; padding: 0.75rem 1.5rem; border: 1px solid #d1d5db; border-radius: 0.5rem; text-decoration: none; color: #374151; background: #fff; font-size: 0.875rem; font-weight: 500; transition: background 0.1s;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='#fff'">
            <svg width="18" height="18" viewBox="0 0 23 23" xmlns="http://www.w3.org/2000/svg">
                <path fill="#f3f3f3" d="M0 0h23v23H0z"/>
                <path fill="#f35325" d="M1 1h10v10H1z"/>
                <path fill="#81bc06" d="M12 1h10v10H12z"/>
                <path fill="#05a6f0" d="M1 12h10v10H1z"/>
                <path fill="#ffba08" d="M12 12h10v10H12z"/>
            </svg>
            Sign in with Microsoft
        </a>

        @if (Model.TestLoginEnabled)
        {
            <div style="position: relative; text-align: center; margin: 0.5rem 0;">
                <span style="background: #fff; padding: 0 0.75rem; color: #9ca3af; font-size: 0.75rem; position: relative; z-index: 1;">or</span>
                <div style="position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: #e5e7eb;"></div>
            </div>

            <form method="post" asp-page-handler="TestLogin" style="display: flex; flex-direction: column; gap: 0.5rem;">
                <div asp-validation-summary="All" style="color: #dc2626; font-size: 0.75rem;"></div>
                <input type="email" name="email" placeholder="Test user email" required
                       style="padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem;" />
                <input type="password" name="password" placeholder="Password" required
                       style="padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.875rem;" />
                <button type="submit" style="padding: 0.625rem; background: #374151; color: #fff; border: none; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 500; cursor: pointer;">
                    Sign in (Test)
                </button>
            </form>
        }
    </div>
</div>
