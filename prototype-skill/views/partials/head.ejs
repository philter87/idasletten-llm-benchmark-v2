<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' && title ? title + ' — ' : '' %>Idasletten</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --norse-dark: #0d1b2a;
      --norse-mid:  #1a3350;
      --norse-gold: #c9a227;
      --norse-gold-l: #e8c84a;
      --norse-bg:   #f5f4ef;
    }
    body { font-family: 'Inter', sans-serif; background: var(--norse-bg); color: #1a1a1a; }
    h1, h2, h3, h4, h5, h6, .font-cinzel { font-family: 'Cinzel', serif; }

    .navbar { background: var(--norse-dark) !important; border-bottom: 2px solid var(--norse-gold); }
    .navbar-brand { font-family: 'Cinzel', serif; color: var(--norse-gold) !important; font-size: 1.4rem; font-weight: 700; letter-spacing: .04em; }
    .nav-link { color: rgba(255,255,255,.8) !important; }
    .nav-link:hover { color: var(--norse-gold) !important; }

    .btn-norse { background: var(--norse-dark); border-color: var(--norse-dark); color: #fff; }
    .btn-norse:hover { background: var(--norse-mid); border-color: var(--norse-mid); color: #fff; }
    .btn-gold { background: var(--norse-gold); border-color: var(--norse-gold); color: var(--norse-dark); font-weight: 600; }
    .btn-gold:hover { background: var(--norse-gold-l); border-color: var(--norse-gold-l); color: var(--norse-dark); }
    .btn-outline-gold { color: var(--norse-gold); border-color: var(--norse-gold); }
    .btn-outline-gold:hover { background: var(--norse-gold); color: var(--norse-dark); }

    .card { border: 1px solid #ddd; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
    .card-header { background: #fff; border-bottom: 1px solid #eee; font-family: 'Cinzel', serif; font-size: .95rem; }

    .page-title { font-family: 'Cinzel', serif; font-size: 1.75rem; font-weight: 700; color: var(--norse-dark); border-bottom: 2px solid var(--norse-gold); padding-bottom: .4rem; margin-bottom: 1.5rem; }

    .hero { background: linear-gradient(135deg, var(--norse-dark) 0%, var(--norse-mid) 100%); color: #fff; padding: 4rem 0 3rem; border-bottom: 3px solid var(--norse-gold); }
    .hero-title { font-family: 'Cinzel', serif; font-size: 3.5rem; font-weight: 700; color: var(--norse-gold); text-shadow: 2px 2px 10px rgba(0,0,0,.4); letter-spacing: .04em; }
    .hero-quote { font-style: italic; color: rgba(255,255,255,.85); max-width: 680px; line-height: 1.75; }

    .t-card { transition: transform .15s, box-shadow .15s; cursor: pointer; }
    .t-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,.12); }
    .t-card .card-title { font-family: 'Cinzel', serif; font-size: 1.05rem; }

    .table-scoreboard th { font-family: 'Cinzel', serif; font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; background: var(--norse-dark); color: var(--norse-gold); border-color: var(--norse-mid); white-space: nowrap; }
    .table-scoreboard td { vertical-align: middle; }
    .table-scoreboard tbody tr:hover td { background: #fdf7e6; }

    .score-badge { background: var(--norse-dark); color: var(--norse-gold); font-family: 'Cinzel', serif; font-weight: 600; padding: .15em .5em; border-radius: 4px; font-size: .9rem; }
    .rank-num { font-family: 'Cinzel', serif; font-weight: 700; color: #bbb; font-size: 1rem; }
    .rank-num.gold { color: #c9a227; }
    .rank-num.silver { color: #9a9a9a; }
    .rank-num.bronze { color: #b87333; }

    .avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--norse-dark); color: var(--norse-gold); display: inline-flex; align-items: center; justify-content: center; font-family: 'Cinzel', serif; font-size: .65rem; font-weight: 700; flex-shrink: 0; }

    .diff-pos { color: #198754; font-weight: 600; }
    .diff-neg { color: #dc3545; font-weight: 600; }

    .match-chip { border-left: 3px solid var(--norse-gold); padding: .45rem .7rem; background: #fff; border-radius: 0 4px 4px 0; margin-bottom: .4rem; cursor: pointer; transition: background .1s; }
    .match-chip:hover { background: #fdf3d0; }

    .sys-badge { background: #e9ecef; color: #555; font-size: .72rem; padding: .15em .45em; border-radius: 3px; }

    .badge-planned { background: #dbeafe; color: #1d4ed8; }
    .badge-done    { background: #dcfce7; color: #15803d; }

    .sidebar-label { font-family: 'Cinzel', serif; font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: #888; margin-bottom: .4rem; }

    footer { background: var(--norse-dark); color: rgba(255,255,255,.45); border-top: 2px solid var(--norse-gold); padding: 1.25rem 0; margin-top: 3rem; font-size: .82rem; text-align: center; }
  </style>
</head>
<body>
