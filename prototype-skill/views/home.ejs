<%- include('partials/head', { title: 'Hjem' }) %>
<%- include('partials/nav') %>

<div class="hero">
  <div class="container">
    <h1 class="hero-title">Idasletten</h1>
    <p class="hero-quote mt-3 mb-4">
      "Idasletten (Iðavöllr) findes i nordisk mytologi lige uden for Valhals porte. Det er her vikingerne som er døde i krig udkæmper deres drabelige slag hver dag, som øvelse til Ragnarok. Hver aften er Idasletten rød af blod."
    </p>
    <a href="/tournaments?all=1" class="text-white-50 small">Se historiske turneringer →</a>
  </div>
</div>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">Aktive Turneringer</h2>
    <a href="/tournaments/create" class="btn btn-norse"><i class="bi bi-plus-lg me-1"></i>Opret turnering</a>
  </div>

  <% if (tournaments.length === 0) { %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-trophy" style="font-size:3rem;opacity:.3"></i>
      <p class="mt-3">Ingen aktive turneringer endnu.</p>
      <a href="/tournaments/create" class="btn btn-gold">Opret den første turnering</a>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% tournaments.forEach(t => { %>
        <div class="col-md-6 col-lg-4">
          <a href="/tournaments/<%= t.id %>" class="text-decoration-none">
            <div class="card t-card h-100">
              <div class="card-body">
                <h5 class="card-title"><%= t.name %></h5>
                <div class="d-flex gap-1 flex-wrap mb-3">
                  <span class="sys-badge"><%= t.scoreSystem %></span>
                  <span class="sys-badge"><%= t.teamSize %>v<%= t.teamSize %></span>
                  <span class="sys-badge">Mål: <%= t.pointsToWin %></span>
                </div>
                <div class="d-flex gap-3 text-muted small">
                  <span><i class="bi bi-people-fill me-1"></i><%= t.playerCount %> spillere</span>
                  <span><i class="bi bi-shield-fill me-1"></i><%= t.matchCount %> kampe</span>
                </div>
              </div>
              <div class="card-footer d-flex justify-content-between py-2 text-muted small">
                <span><% if (t.maxPlayerCount) { %><%= t.playerCount %>/<%= t.maxPlayerCount %> pladser<% } else { %>Åben<% } %></span>
                <span><%= new Date(t.createdAt).toLocaleDateString('da-DK') %></span>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
