<%- include('partials/head', { title: 'Log ind' }) %>
<%- include('partials/nav') %>

<div class="container py-5" style="max-width:420px">
  <div class="text-center mb-4">
    <span style="font-size:3rem">⚡</span>
    <h1 class="page-title mt-2">Log ind</h1>
    <p class="text-muted">Log ind for at oprette turneringer og redigere afsluttede kampe.</p>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <!-- Microsoft (disabled in prototype) -->
      <button class="btn btn-lg w-100 mb-3 d-flex align-items-center justify-content-center gap-2"
        style="background:#0078d4;color:#fff;border:none;opacity:.6" disabled title="Ikke tilgængelig i prototype">
        <svg width="20" height="20" viewBox="0 0 21 21" fill="none">
          <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
          <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
          <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
          <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
        </svg>
        Log ind med Microsoft (Azure AD)
      </button>
      <div class="text-center mb-3">
        <span class="badge bg-secondary" style="font-size:.7rem">Ikke tilgængelig i prototype</span>
      </div>

      <div class="d-flex align-items-center gap-2 mb-3">
        <hr class="flex-grow-1 m-0" /><small class="text-muted">eller</small><hr class="flex-grow-1 m-0" />
      </div>

      <!-- Test login -->
      <form method="POST" action="/login/test">
        <div class="mb-3">
          <label class="form-label fw-medium">Test-login via initialer</label>
          <input type="text" name="initials" class="form-control text-uppercase"
            placeholder="F.eks. PCH" maxlength="5" required autofocus />
          <div class="form-text">Skriv dine initialer. Ukendte initialer opretter en ny bruger.</div>
        </div>
        <button type="submit" class="btn btn-norse w-100">
          <i class="bi bi-person-check me-1"></i>Log ind som testbruger
        </button>
      </form>
    </div>
  </div>

  <div class="text-center mt-3">
    <a href="/" class="text-muted small">← Tilbage til forsiden</a>
  </div>
</div>

<%- include('partials/footer') %>
