@page
@model Idasletten.Pages.Tournaments.CreateModel
@{
    ViewData["Title"] = "Create Tournament";
}

<h2>Create Tournament</h2>

<form method="post">
    <div class="form-group">
        <label for="Name">Name</label>
        <input type="text" id="Name" name="Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="TeamSize">Team Size</label>
        <input type="number" id="TeamSize" name="TeamSize" class="form-control" value="2" min="1" max="4" />
    </div>
    <div class="form-group">
        <label for="PointsToWin">Points to Win</label>
        <input type="number" id="PointsToWin" name="PointsToWin" class="form-control" value="5" min="1" />
    </div>
    <div class="form-group">
        <label for="ScoreSystem">Score System</label>
        <select id="ScoreSystem" name="ScoreSystem" class="form-control">
            <option value="Elo">Elo</option>
            <option value="TrueSkill">TrueSkill</option>
            <option value="Lives">Lives</option>
            <option value="WinCount">Win Count</option>
        </select>
    </div>
    <div class="form-group">
        <label for="MaxPlayerCount">Max Player Count (optional)</label>
        <input type="number" id="MaxPlayerCount" name="MaxPlayerCount" class="form-control" />
    </div>
    <div class="form-group">
        <label>
            <input type="checkbox" name="IsPublic" value="true" checked /> Public
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <button type="submit" class="btn" name="PlanMatches" value="true">Create and Plan Matches</button>
</form>
