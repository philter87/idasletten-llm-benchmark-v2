@page "/users/{userId:guid}"
@model Idasletten.Pages.Users.DetailModel
@{
    ViewData["Title"] = Model.PageUser?.Name ?? "User";
}

@if (Model.PageUser == null)
{
    <div class="alert">User not found.</div>
    return;
}

<h1 class="text-2xl font-bold">@Model.PageUser.Name <small class="text-gray-500">(@Model.PageUser.Initials)</small></h1>

@if (!string.IsNullOrEmpty(Model.PageUser.ImageUrl))
{
    <img src="@Model.PageUser.ImageUrl" alt="@Model.PageUser.Name" class="rounded mb-2" style="max-width: 120px;" />
}

<h3 class="text-lg font-semibold mt-4">Tournament History</h3>

@if (Model.PageUser.TournamentPlayers.Any())
{
    <table class="table w-full">
        <thead>
            <tr>
                <th>Tournament</th>
                <th>Score</th>
                <th>Wins</th>
                <th>Losses</th>
                <th>Matches</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tp in Model.PageUser.TournamentPlayers.OrderByDescending(tp => tp.Score))
            {
                <tr>
                    <td><a href="/tournaments/@tp.TournamentId">@tp.Tournament?.Name</a></td>
                    <td>@tp.Score.ToString("F1")</td>
                    <td>@tp.WinCount</td>
                    <td>@tp.LoseCount</td>
                    <td>@tp.MatchCount</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert">No tournament history.</div>
}
