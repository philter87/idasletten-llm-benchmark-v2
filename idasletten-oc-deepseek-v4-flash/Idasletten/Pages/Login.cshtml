@page "/login"
@model Idasletten.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1 class="text-2xl font-bold">Login</h1>

<div class="grid grid-cols-12 gap-4 mt-4">
    <div class="col-span-6">
        <div class="card">
            <div class="card-body text-center">
                <h3 class="text-lg font-semibold">Sign in with Microsoft</h3>
                <p class="text-sm text-gray-500 mt-1">Use your Mjølner account</p>
                <a href="/login?handler=Microsoft" class="btn w-full mt-2">Microsoft Azure AD</a>
            </div>
        </div>
    </div>
    @if (Model.TestUserEnabled)
    {
        <div class="col-span-6">
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="text-lg font-semibold">Test User</h3>
                    <p class="text-sm text-gray-500 mt-1">For testing purposes only</p>
                    <form method="post" asp-page-handler="TestLogin" class="mt-2">
                        <button type="submit" class="btn btn-outline w-full">Login as Test User</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
