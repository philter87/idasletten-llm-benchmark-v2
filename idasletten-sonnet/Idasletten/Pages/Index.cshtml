@page
@model IndexModel
@{
    ViewData["Title"] = "Hjem";
}

<div class="hero">
    <h1>Idasletten ⚡</h1>
    <p>
        Idasletten (Iðavöllr) findes i nordisk mytologi lige uden for Valhals porte.
        Det er her vikingerne som er døde i krig udkæmper deres drabelige slag hver dag,
        som øvelse til Ragnarok. Hver aften er Idasletten rød af blod.
    </p>
</div>

<div class="flex justify-between items-center mb-4">
    <h2 class="section-title" style="margin:0">Aktive turneringer</h2>
</div>

@if (!Model.PublicTournaments.Any())
{
    <p class="text-muted">Ingen offentlige turneringer endnu.</p>
}
else
{
    <div class="tournament-grid mb-4">
        @foreach (var t in Model.PublicTournaments)
        {
            <a href="/tournaments/@t.Id" style="text-decoration:none;color:inherit">
                <div class="card tournament-card">
                    <h3>@t.Name</h3>
                    <p class="text-muted" style="margin:0">@t.Players.Count spillere · @t.ScoreSystem</p>
                    @if (t.IsArchived)
                    {
                        <span class="badge badge-gray mt-2">Arkiveret</span>
                    }
                </div>
            </a>
        }
    </div>
}

<div style="margin-top:2rem">
    <a href="/tournaments?all=true" class="text-muted" style="font-size:0.875rem">Vis alle turneringer (inkl. arkiverede og private) →</a>
</div>
