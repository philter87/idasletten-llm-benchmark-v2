@page "/tournaments/create"
@model Idasletten.Pages.Tournaments.CreateTournamentModel
@{
    ViewData["Title"] = "Opret turnering";
}

<div style="max-width:600px">
    <h1 class="section-title">Opret turnering</h1>

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label for="Name">Navn</label>
            <input id="Name" name="Name" type="text" required value="@Model.Input.Name" />
            <span asp-validation-for="Input.Name" class="text-muted" style="color:#ef4444"></span>
        </div>

        <div class="form-group">
            <label for="TeamSize">Spillere per hold</label>
            <input id="TeamSize" name="TeamSize" type="number" min="1" max="6" value="@Model.Input.TeamSize" required />
        </div>

        <div class="form-group">
            <label for="PointsToWin">Mål for at vinde</label>
            <input id="PointsToWin" name="PointsToWin" type="number" min="1" value="@Model.Input.PointsToWin" required />
        </div>

        <div class="form-group">
            <label for="ScoreSystem">Pointsystem</label>
            <select id="ScoreSystem" name="ScoreSystem">
                <option value="Elo">Elo — klassisk rating, justeres ud fra styrkeforskelle</option>
                <option value="TrueSkill">TrueSkill — Microsofts probabilistiske rating</option>
                <option value="Lives">Lives — tab et liv ved hvert nederlag</option>
                <option value="WinCount">Sejre — simpel optælling af vundne kampe</option>
            </select>
        </div>

        <div class="form-group">
            <label for="MaxPlayerCount">Maks antal spillere (valgfri)</label>
            <input id="MaxPlayerCount" name="MaxPlayerCount" type="number" min="2" value="@Model.Input.MaxPlayerCount" placeholder="Ingen grænse" />
        </div>

        <div class="form-group" style="display:flex;gap:0.75rem;align-items:center">
            <input id="IsPublic" name="IsPublic" type="checkbox" @(Model.Input.IsPublic ? "checked" : "") style="width:auto" />
            <label for="IsPublic" style="margin:0">Offentlig turnering</label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Opret</button>
            <a href="/tournaments" class="btn btn-secondary">Annuller</a>
        </div>
    </form>
</div>
