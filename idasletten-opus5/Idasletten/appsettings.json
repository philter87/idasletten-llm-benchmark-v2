{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Empty means SQLite in-memory. Production sets ConnectionStrings__Idasletten to a file path.
    "Idasletten": ""
  },
  // Seeding follows the database when nothing is set: on for the in-memory one, off for a file.
  // Set Seed__Enabled explicitly to override.
  //"Seed": { "Enabled": true },
  "AzureAd": {
    // Set TenantId/ClientId/ClientSecret (user secrets or fly secrets) to enable Microsoft login and
    // profile pictures from the Graph API. Without them the app runs with the test login only.
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc"
  },
  "TestUser": {
    // Only enabled when both TestUser__Email and TestUser__Password are set as environment variables.
    "Initials": "TST",
    "Name": "Test Viking"
  }
}
