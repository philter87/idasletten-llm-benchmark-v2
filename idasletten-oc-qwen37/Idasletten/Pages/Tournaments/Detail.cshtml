@page "{id:guid}"
@model Idasletten.Pages.Tournaments.DetailModel
@{
    ViewData["Title"] = Model.Tournament?.Name ?? "Tournament";
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold">@Model.Tournament?.Name</h1>
        <p class="text-gray-600 mt-2">
            Score System: @Model.Tournament?.ScoreSystem |
            Team Size: @Model.Tournament?.TeamSize |
            Points to Win: @Model.Tournament?.PointsToWin
            @if (Model.Tournament?.RoundNumber > 1)
            {
                <span>| Round @Model.Tournament.RoundNumber</span>
            }
        </p>
    </div>
</div>

<div class="flex gap-8">
    <div class="flex-1">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold">Scoreboard</h2>
            <button onclick="document.getElementById('addPlayerModal').classList.remove('hidden')"
                    class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                Add Player
            </button>
        </div>

        @if (Model.Tournament?.Players.Any() == true)
        {
            <div class="border border-gray-200 rounded-lg overflow-hidden">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Rank</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Player</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Score</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Delta</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">W</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">L</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Matches</th>
                            @if (Model.Tournament.ScoreSystem == Idasletten.Models.ScoreSystem.Lives)
                            {
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Lives</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @{
                            var rankedPlayers = Model.Tournament.Players.OrderByDescending(p => p.Score).ToList();
                            var rank = 1;
                        }
                        @foreach (var player in rankedPlayers)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 text-gray-600">@rank</td>
                                <td class="px-4 py-3">
                                    <a href="/users/@player.UserId" class="text-blue-600 hover:underline font-medium">
                                        @player.User.Username
                                    </a>
                                    @if (!string.IsNullOrEmpty(player.User.Name))
                                    {
                                        <span class="text-gray-500 text-sm">(@player.User.Name)</span>
                                    }
                                </td>
                                <td class="px-4 py-3 font-semibold">@player.Score.ToString("F0")</td>
                                <td class="px-4 py-3">
                                    @if (player.ScoreDiff > 0)
                                    {
                                        <span class="text-green-600">+@player.ScoreDiff.ToString("F0")</span>
                                    }
                                    else if (player.ScoreDiff < 0)
                                    {
                                        <span class="text-red-600">@player.ScoreDiff.ToString("F0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">0</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-green-600">@player.WinCount</td>
                                <td class="px-4 py-3 text-red-600">@player.LoseCount</td>
                                <td class="px-4 py-3 text-gray-600">@player.MatchCount</td>
                                @if (Model.Tournament.ScoreSystem == Idasletten.Models.ScoreSystem.Lives)
                                {
                                    <td class="px-4 py-3 font-semibold">@player.Lives</td>
                                }
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-gray-600">No players yet. Add players to get started.</p>
        }
    </div>

    <div class="w-80">
        <a href="/tournaments/@Model.Tournament?.Id/create-match"
           class="block w-full bg-blue-600 text-white px-4 py-3 rounded text-center hover:bg-blue-700 mb-6">
            Create Match
        </a>

        <div class="border border-gray-200 rounded-lg p-4 mb-4">
            <h3 class="font-semibold mb-3">Next Matches</h3>
            @if (Model.NextMatches.Any())
            {
                <div class="space-y-2">
                    @foreach (var match in Model.NextMatches)
                    {
                        <a href="/tournaments/@Model.Tournament?.Id/create-match?matchId=@match.Id"
                           class="block p-2 border border-gray-200 rounded hover:bg-gray-50 text-sm">
                            Match #@match.Order
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500 text-sm">No planned matches</p>
            }
        </div>

        <div class="border border-gray-200 rounded-lg p-4 mb-4">
            <h3 class="font-semibold mb-3">Recent Matches</h3>
            @if (Model.RecentMatches.Any())
            {
                <div class="space-y-2">
                    @foreach (var match in Model.RecentMatches)
                    {
                        <a href="/tournaments/@Model.Tournament?.Id/matches/@match.Id"
                           class="block p-2 border border-gray-200 rounded hover:bg-gray-50 text-sm">
                            Match #@match.Order
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500 text-sm">No completed matches</p>
            }
        </div>

        <a href="/tournaments/@Model.Tournament?.Id/matches"
           class="block text-center text-blue-600 hover:underline text-sm">
            View all matches
        </a>
    </div>
</div>

<div id="addPlayerModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center">
    <div class="bg-white rounded-lg p-6 w-96">
        <h3 class="text-xl font-bold mb-4">Add Player</h3>
        <form method="post" asp-page-handler="AddPlayer">
            <input type="hidden" name="tournamentId" value="@Model.Tournament?.Id" />
            <div class="mb-4">
                <label class="block text-sm font-medium mb-2">Initials/Username</label>
                <input type="text" name="username" required maxlength="10"
                       class="w-full border border-gray-300 rounded px-3 py-2" />
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium mb-2">Name (optional)</label>
                <input type="text" name="name" maxlength="200"
                       class="w-full border border-gray-300 rounded px-3 py-2" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="flex-1 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                    Add Player
                </button>
                <button type="button" onclick="document.getElementById('addPlayerModal').classList.add('hidden')"
                        class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>
