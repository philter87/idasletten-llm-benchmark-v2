@page
@model Idasletten.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="mb-12">
    <div class="bg-gradient-to-r from-red-900 to-red-700 rounded-lg p-12 text-white mb-8">
        <h1 class="text-4xl font-bold mb-4">Idasletten (Iðavöllr)</h1>
        <p class="text-lg italic">
            "Idasletten (Iðavöllr) findes i nordisk mytologi lige uden for Valhals porte. Det er her vikingerne som er døde i krig udkæmper deres drabelige slag hver dag, som øvelse til Ragnarok. Hver aften er Idasletten rød af blod."
        </p>
    </div>
</div>

<section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">Active Tournaments</h2>
    @if (Model.PublicTournaments.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var tournament in Model.PublicTournaments)
            {
                <a href="/tournaments/@tournament.Id" class="block border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
                    <h3 class="text-xl font-semibold mb-2">@tournament.Name</h3>
                    <div class="text-sm text-gray-600 space-y-1">
                        <p>Players: @tournament.Players.Count</p>
                        <p>Score System: @tournament.ScoreSystem</p>
                        <p>Team Size: @tournament.TeamSize</p>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-gray-600">No active tournaments available.</p>
    }
</section>

<section>
    <a href="/tournaments?all=true" class="text-sm text-gray-500 hover:text-gray-700 underline">
        View all tournaments (including archived and private)
    </a>
</section>
