@page "/users/{userId:guid}"
@model Idasletten.Pages.Users.DetailModel
@{
    ViewData["Title"] = Model.Stats?.Username ?? "Player";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-bold">
            @Model.Stats?.Username
            @if (!string.IsNullOrEmpty(Model.Stats?.Name))
            {
                <span class="text-gray-500 text-xl">(@Model.Stats.Name)</span>
            }
        </h1>
    </div>

    @if (Model.Stats != null)
    {
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="border border-gray-200 rounded-lg p-4">
                <div class="text-sm text-gray-600">Total Matches</div>
                <div class="text-2xl font-bold">@Model.Stats.TotalMatches</div>
            </div>
            <div class="border border-gray-200 rounded-lg p-4">
                <div class="text-sm text-gray-600">Wins</div>
                <div class="text-2xl font-bold text-green-600">@Model.Stats.TotalWins</div>
            </div>
            <div class="border border-gray-200 rounded-lg p-4">
                <div class="text-sm text-gray-600">Losses</div>
                <div class="text-2xl font-bold text-red-600">@Model.Stats.TotalLosses</div>
            </div>
            <div class="border border-gray-200 rounded-lg p-4">
                <div class="text-sm text-gray-600">Points Won/Lost</div>
                <div class="text-2xl font-bold">
                    @Model.Stats.TotalPointsWon / @Model.Stats.TotalPointsLost
                </div>
            </div>
        </div>

        <h2 class="text-2xl font-bold mb-4">Tournament History</h2>
        @if (Model.Stats.Tournaments.Any())
        {
            <div class="border border-gray-200 rounded-lg overflow-hidden">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tournament</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Matches</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Wins</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Losses</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Score</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @foreach (var tournament in Model.Stats.Tournaments)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3">
                                    <a href="/tournaments/@tournament.TournamentId" class="text-blue-600 hover:underline">
                                        @tournament.TournamentName
                                    </a>
                                </td>
                                <td class="px-4 py-3">@tournament.Matches</td>
                                <td class="px-4 py-3 text-green-600">@tournament.Wins</td>
                                <td class="px-4 py-3 text-red-600">@tournament.Losses</td>
                                <td class="px-4 py-3 font-semibold">@tournament.Score.ToString("F0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-gray-600">No tournament history.</p>
        }
    }
    else
    {
        <p class="text-gray-600">Player not found.</p>
    }
</div>
