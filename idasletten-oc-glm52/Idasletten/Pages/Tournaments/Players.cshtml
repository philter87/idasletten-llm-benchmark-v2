@page
@model PlayersModel
@{
    ViewData["Title"] = $"Players — {Model.Tournament.Name}";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
    <h1 class="section-title" style="margin:0">Players</h1>
    <div>
        <a asp-page="/Tournaments/Detail" asp-route-id="@Model.Tournament.Id" class="bc-btn-ghost">← Back</a>
        <button class="bc-btn-primary" data-dialog="addDlg">+ Add a player</button>
    </div>
</div>

<table class="bc-table">
    <thead><tr><th>Player</th><th>W</th><th>L</th><th>Played</th><th>Pts</th><th>Score</th></tr></thead>
    <tbody>
    @if (Model.Players.Count == 0) { <tr><td colspan="6" class="dim" style="text-align:center">No players added yet.</td></tr> }
    @foreach (var p in Model.Players)
    {
        <tr>
            <td><a asp-page="/Users/Detail" asp-route-id="@p.UserId">@p.Username</a> · <span class="dim">@p.Name</span></td>
            <td>@p.WinCount</td>
            <td>@p.LoseCount</td>
            <td>@p.MatchCount</td>
            <td>@p.PointsWon-@p.PointsLost</td>
            <td>@(Model.Tournament.ScoreSystem == ScoreSystem.Lives ? $"{p.Lives}❤" : p.Score.ToString("0.##"))</td>
        </tr>
    }
    </tbody>
</table>

<h2 class="section-title" style="margin-top:30px">Add players based on a previous tournament</h2>
@if (!Model.HasSeed)
{
    <form method="post" asp-page-handler="SetSeed" asp-route-id="@Model.Tournament.Id" style="display:flex;gap:8px;align-items:center;margin-bottom:14px">
        <select name="seedTournamentId" class="bc-select" style="max-width:520px">
            <option value="">Select tournament to seed from…</option>
            @foreach (var t in Model.AllTournaments.Where(x => x.Id != Model.Tournament.Id))
            {
                <option value="@t.Id">@t.Name (@t.ScoreSystem, @t.PlayerCount players)</option>
            }
        </select>
        <button class="bc-btn-ghost" type="submit">Use as seed</button>
    </form>
    <p class="dim">Once selected, the players are listed for adding below.</p>
}
else
{
    <form method="post" asp-page-handler="AddFromSeed" asp-route-id="@Model.Tournament.Id">
        <ul style="list-style:none;padding:0;margin:0">
        @foreach (var p in Model.SeedPlayers)
        {
            <li class="match-team-row" style="display:flex;justify-content:space-between;align-items:center">
                <span class="@(p.AlreadyInCurrent ? "strike-name" : "")">
                    @p.Username · @p.Name <span class="dim">(score @(p.SourceScore.ToString("0.##")) there)</span>
                </span>
                @if (!p.AlreadyInCurrent)
                {
                    <span style="display:flex;align-items:center;gap:6px">
                        <input type="checkbox" name="userIds" value="@p.UserId" id="u_@p.UserId" />
                        <label for="u_@p.UserId" class="bc-btn-ghost" style="margin:0">+ Add</label>
                    </span>
                }
                else
                {
                    <span class="bc-badge state-done">added</span>
                }
            </li>
        }
        </ul>
        <button class="bc-btn-primary" type="submit" style="margin-top:12px">Add selected</button>
    </form>
}

<dialog id="addDlg" class="bc-dialog">
    <h3>Add player</h3>
    <form method="post" asp-page-handler="Add" asp-route-id="@Model.Tournament.Id">
        <input type="hidden" name="returnUrl" value="@Request.Path" />
        <label class="bc-label">Initials</label>
        <input name="username" class="bc-input" maxlength="4" required style="text-transform:uppercase" />
        <label class="bc-label" style="margin-top:10px">Name (optional)</label>
        <input name="name" class="bc-input" />
        <div style="display:flex;gap:8px;margin-top:14px;justify-content:flex-end">
            <button type="button" class="bc-btn-ghost bc-dialog-close">Cancel</button>
            <button type="submit" class="bc-btn-primary">Add</button>
        </div>
    </form>
</dialog>