@page
@model IndexModel
@{
    ViewData["Title"] = "Tournaments";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
    <h1 class="section-title" style="margin:0">All tournaments</h1>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Tournaments/Create" class="bc-btn-primary">+ Create tournament</a>
    }
</div>

<table class="bc-table">
    <thead><tr><th>Name</th><th>System</th><th>Players</th><th>Format</th><th>Status</th></tr></thead>
    <tbody>
    @if (Model.Tournaments.Count == 0)
    {
        <tr><td colspan="5" class="dim" style="text-align:center">No tournaments yet.</td></tr>
    }
    @foreach (var t in Model.Tournaments)
    {
        <tr>
            <td><a asp-page="/Tournaments/Detail" asp-route-id="@t.Id">@t.Name</a></td>
            <td>@t.ScoreSystem</td>
            <td>@t.PlayerCount</td>
            <td>@t.TeamSize v @t.TeamSize · to @t.PointsToWin</td>
            <td>
                @if (t.IsArchived) { <span class="bc-badge state-cancelled">Archived</span> }
                else if (t.ParentTournamentId.HasValue) { <span class="bc-badge state-planned">Round @t.RoundNumber</span> }
                else { <span class="bc-badge state-done">Active</span> }
            </td>
        </tr>
    }
    </tbody>
</table>