@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Idasletten</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://basecoatui.com/css/basecoat.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="bc-header">
        <nav class="bc-navbar bc-container">
            <a class="bc-navbar-brand" asp-area="" asp-page="/Index">
                <span class="norse-mark">ᛁ</span> Idasletten
            </a>
            <button class="bc-navbar-toggle" type="button" aria-label="Toggle navigation" data-toggle="collapse" data-target="#nav">
                <span></span><span></span><span></span>
            </button>
            <div class="bc-navbar-nav" id="nav">
                <a class="bc-nav-link" asp-area="" asp-page="/Index">Home</a>
                <a class="bc-nav-link" asp-area="" asp-page="/Tournaments/Index">Tournaments</a>
                @if (isAuthenticated)
                {
                    <a class="bc-nav-link" asp-area="" asp-page="/Tournaments/Create">Create</a>
                    <form method="post" asp-page="/Logout" class="bc-nav-link" style="display:inline">
                        <button type="submit" class="bc-btn bc-btn-ghost">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="bc-nav-link" asp-area="" asp-page="/Login">Login</a>
                }
            </div>
        </nav>
    </header>

    <main class="bc-container main-content">
        @RenderBody()
    </main>

    <footer class="bc-footer">
        <div class="bc-container">
            <span>&copy; @DateTime.UtcNow.Year — Idasletten · Iðavöllr</span>
            <a asp-area="" asp-page="/Tournaments/Index" class="bc-link">All tournaments</a>
        </div>
    </footer>

    <script src="https://basecoatui.com/js/basecoat.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>