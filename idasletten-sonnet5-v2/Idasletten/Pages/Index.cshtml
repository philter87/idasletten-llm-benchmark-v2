@page
@model IndexModel
@{
    ViewData["Title"] = "Idasletten";
}

<section class="rounded-lg border" style="background: linear-gradient(135deg, #7f1d1d 0%, #450a0a 55%, #1c1917 100%); color: #fef2f2; padding: 3rem 2rem; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem;">
    <h1 style="font-size: 2.25rem; font-weight: 800; margin: 0;">⚔️ Idasletten</h1>
    <p style="max-width: 48rem; font-size: 1.05rem; line-height: 1.6;">
        Idasletten (Iðavöllr) findes i nordisk mytologi lige uden for Valhals porte. Det er her vikingerne som er
        døde i krig udkæmper deres drabelige slag hver dag, som øvelse til Ragnarok. Hver aften er Idasletten rød
        af blod.
    </p>
</section>

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
    <h2 style="font-size: 1.5rem; font-weight: 700; margin: 0;">Public tournaments</h2>
    <a asp-page="/Tournaments/Index" class="text-sm text-muted-foreground" style="text-decoration: underline;">Historical tournaments</a>
</div>

@if (Model.PublicTournaments.Count == 0)
{
    <p class="text-muted-foreground">No public tournaments yet.</p>
}
else
{
    <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
        @foreach (var tournament in Model.PublicTournaments)
        {
            <a asp-page="/Tournaments/Details" asp-route-id="@tournament.Id" style="text-decoration: none; color: inherit; flex: 1 1 16rem;">
                <div class="card">
                    <header>
                        <h2>@tournament.Name</h2>
                        <p>@tournament.ScoreSystem &middot; @tournament.TeamSize player(s) per team</p>
                    </header>
                    <section>
                        <span class="badge">@tournament.PlayerCount players</span>
                    </section>
                </div>
            </a>
        }
    </div>
}
