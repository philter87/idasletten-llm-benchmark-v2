@page
@model Idasletten.Pages.Tournaments.DetailsModel
@{
    ViewData["Title"] = Model.Tournament.Name;
    var t = Model.Tournament;
}

<div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 700; margin: 0;">@t.Name</h1>
        <p class="text-muted-foreground text-sm">
            @t.ScoreSystem &middot; @t.TeamSize player(s) per team &middot; first to @t.PointsToWin
            @if (t.RoundNumber is { } round && round > 1)
            {
                <span>&middot; Round @round</span>
            }
        </p>
    </div>
    <div style="display:flex; gap: 0.5rem;">
        @if (t.IsArchived) { <span class="badge" data-variant="secondary">Archived</span> }
        @if (!t.IsPublic) { <span class="badge" data-variant="outline">Private</span> }
    </div>
</div>

<div style="display: flex; gap: 1.5rem; align-items: flex-start; flex-wrap: wrap;">
    <div style="flex: 3 1 32rem; min-width: 20rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <h2 style="font-size: 1.25rem; font-weight: 600; margin: 0;">Scoreboard</h2>
            <button type="button" class="btn" data-size="sm" onclick="document.getElementById('add-player-dialog').showModal()">Add player</button>
        </div>

        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Player</th>
                        <th class="text-end">Score</th>
                        <th class="text-end">&Delta;</th>
                        <th class="text-end">Won</th>
                        <th class="text-end">Lost</th>
                        <th class="text-end">Played</th>
                        @if (t.ScoreSystem == ScoreSystem.Lives)
                        {
                            <th class="text-end">Lives</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{ var rank = 0; }
                    @foreach (var player in t.Scoreboard)
                    {
                        rank++;
                        <tr>
                            <td>@rank</td>
                            <td class="font-medium">
                                <a asp-page="/Users/Details" asp-route-id="@player.UserId" style="text-decoration: underline;">@player.Name (@player.Username)</a>
                            </td>
                            <td class="text-end">@player.Score.ToString("0.##")</td>
                            <td class="text-end">@(player.ScoreDiff >= 0 ? "+" : "")@player.ScoreDiff.ToString("0.##")</td>
                            <td class="text-end">@player.WinCount</td>
                            <td class="text-end">@player.LoseCount</td>
                            <td class="text-end">@player.MatchCount</td>
                            @if (t.ScoreSystem == ScoreSystem.Lives)
                            {
                                <td class="text-end">@player.Lives</td>
                            }
                        </tr>
                    }
                    @if (t.Scoreboard.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted-foreground">No players yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="flex: 1 1 16rem; min-width: 16rem; display: flex; flex-direction: column; gap: 1rem;">
        <button type="button" class="btn" style="width: 100%;"
                onclick="location.href = '@Url.Page("/Tournaments/CreateMatch", new { id = t.TournamentId })?matchId=' + (crypto.randomUUID ? crypto.randomUUID() : Date.now())">
            Create match
        </button>

        <div class="card">
            <header><h3>Next planned matches</h3></header>
            <section style="display: flex; flex-direction: column; gap: 0.5rem;">
                @if (t.NextPlannedMatches.Count == 0)
                {
                    <p class="text-muted-foreground text-sm">No planned matches.</p>
                }
                else
                {
                    @foreach (var match in t.NextPlannedMatches)
                    {
                        <a asp-page="/Tournaments/CreateMatch" asp-route-id="@t.TournamentId" asp-route-matchId="@match.MatchId" style="text-decoration: none; color: inherit;">
                            <div class="border rounded-md" style="padding: 0.5rem 0.75rem;">
                                @string.Join(" vs ", match.Teams.Select(team => string.Join("+", team.PlayerUsernames)))
                            </div>
                        </a>
                    }
                }
            </section>
        </div>

        <div class="card">
            <header><h3>Recent results</h3></header>
            <section style="display: flex; flex-direction: column; gap: 0.5rem;">
                @if (t.RecentPlayedMatches.Count == 0)
                {
                    <p class="text-muted-foreground text-sm">No matches played yet.</p>
                }
                else
                {
                    @foreach (var match in t.RecentPlayedMatches)
                    {
                        <a asp-page="/Tournaments/CreateMatch" asp-route-id="@t.TournamentId" asp-route-matchId="@match.MatchId" style="text-decoration: none; color: inherit;">
                            <div class="border rounded-md" style="padding: 0.5rem 0.75rem;">
                                @string.Join(" vs ", match.Teams.Select(team => $"{string.Join("+", team.PlayerUsernames)} ({team.GoalsWon})"))
                            </div>
                        </a>
                    }
                }
            </section>
        </div>

        <a asp-page="/Tournaments/Matches" asp-route-id="@t.TournamentId" class="text-sm" style="text-decoration: underline; text-align: center;">View all matches</a>
    </div>
</div>

<dialog id="add-player-dialog" class="dialog" aria-labelledby="add-player-title">
    <div class="sm:max-w-sm">
        <form method="post" asp-page-handler="AddPlayer" asp-route-id="@t.TournamentId">
            <header>
                <h2 id="add-player-title">Add player</h2>
                <p>New initials automatically create a player.</p>
            </header>
            <section style="display: flex; flex-direction: column; gap: 0.75rem;">
                <div role="group" class="field">
                    <label for="AddPlayerUsername">Initials</label>
                    <input type="text" id="AddPlayerUsername" name="AddPlayerUsername" class="input" maxlength="16" required />
                </div>
                <div role="group" class="field">
                    <label for="AddPlayerName">Name (optional)</label>
                    <input type="text" id="AddPlayerName" name="AddPlayerName" class="input" />
                </div>
            </section>
            <footer>
                <button type="button" class="btn" data-variant="outline" onclick="this.closest('dialog').close()">Cancel</button>
                <button type="submit" class="btn">Add</button>
            </footer>
        </form>
    </div>
</dialog>
