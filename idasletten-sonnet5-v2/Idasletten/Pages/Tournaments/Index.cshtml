@page
@model Idasletten.Pages.Tournaments.IndexModel
@{
    ViewData["Title"] = "Tournaments";
}

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
    <h1 style="font-size: 1.75rem; font-weight: 700; margin: 0;">All tournaments</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Tournaments/Create" class="btn">Create tournament</a>
    }
    else
    {
        <a asp-page="/Login" asp-route-returnUrl="/tournaments/create" class="btn">Log in to create tournament</a>
    }
</div>

@if (Model.Tournaments.Count == 0)
{
    <p class="text-muted-foreground">No tournaments yet.</p>
}
else
{
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Score system</th>
                    <th>Team size</th>
                    <th>Players</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tournament in Model.Tournaments)
                {
                    <tr>
                        <td class="font-medium">@tournament.Name</td>
                        <td>@tournament.ScoreSystem</td>
                        <td>@tournament.TeamSize</td>
                        <td>@tournament.PlayerCount</td>
                        <td class="text-end">
                            @if (tournament.IsArchived)
                            {
                                <span class="badge" data-variant="secondary">Archived</span>
                            }
                            @if (!tournament.IsPublic)
                            {
                                <span class="badge" data-variant="outline">Private</span>
                            }
                            <a asp-page="/Tournaments/Details" asp-route-id="@tournament.Id" class="btn" data-variant="outline" data-size="sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
