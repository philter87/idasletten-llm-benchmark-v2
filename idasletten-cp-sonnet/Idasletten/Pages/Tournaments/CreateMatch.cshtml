@page "/tournaments/{id}/create-match"
@model Idasletten.Pages.Tournaments.CreateMatchModel
@{
    ViewData["Title"] = "Registrer kamp";
    var t = Model.Tournament;
}

@if (t == null)
{
    <p>Turnering ikke fundet.</p>
    return;
}

<div class="page-header">
    <div>
        <div style="font-size: 0.875rem; color: #6b7280; margin-bottom: 0.25rem;">
            <a href="/tournaments/@t.Id" style="color: #6b7280; text-decoration: none;">@t.Name</a> /
        </div>
        <h1>@(Model.IsEdit ? "Rediger kamp" : "Registrer kamp")</h1>
    </div>
</div>

<div style="max-width: 600px;">
    <form method="post">
        @if (Model.IsEdit)
        {
            <input type="hidden" name="ExistingMatchId" value="@Model.ExistingMatchId" />
        }
        <input type="hidden" name="TournamentId" value="@t.Id" />

        @for (int i = 0; i < t.TeamSize; i++)
        {
            <div class="card" style="margin-bottom: 1rem;">
                <div class="card-title">Hold @(i + 1)</div>
                <div class="form-group">
                    <label class="form-label">Spillere (initialer, kommasepareret)</label>
                    <input type="text"
                           name="Teams[@i].PlayerInitials"
                           class="form-input"
                           value="@Model.GetTeamInitials(i)"
                           placeholder="f.eks. ALK, BNS"
                           style="text-transform: uppercase;" />
                    <div style="margin-top: 0.5rem;">
                        <button type="button" class="btn-secondary" style="font-size: 0.8rem; padding: 0.25rem 0.5rem;"
                                onclick="openPlayerPicker(@i)">
                            Vælg fra liste
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Mål</label>
                    <input type="number" name="Teams[@i].Goals" class="form-input"
                           value="@Model.GetTeamGoals(i)" min="0" max="99" style="width: 80px;" />
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background: #fee2e2; color: #991b1b; padding: 0.75rem; border-radius: 0.375rem; margin-bottom: 1rem;">
                @Model.ErrorMessage
            </div>
        }

        <div style="display: flex; gap: 0.75rem; align-items: center;">
            <button type="submit" class="btn-primary">
                @(Model.IsEdit ? "Opdater kamp" : "Registrer kamp")
            </button>
            <a href="/tournaments/@t.Id" style="color: #6b7280; text-decoration: none; font-size: 0.875rem;">Annuller</a>
        </div>
    </form>
</div>

<!-- Player Picker Dialog -->
<div id="player-picker-dialog" class="dialog-overlay">
    <div class="dialog-content" style="max-width: 400px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="margin: 0; font-size: 1rem; font-weight: 600;">Vælg spillere</h3>
            <button onclick="closeDialog('player-picker-dialog')" style="background: none; border: none; cursor: pointer; font-size: 1.25rem;">×</button>
        </div>
        <div id="player-list">
            @foreach (var p in Model.Tournament?.Players ?? [])
            {
                <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0; cursor: pointer;">
                    <input type="checkbox" value="@p.Username" class="player-checkbox" />
                    <span style="font-weight: 500;">@p.Username</span>
                    @if (!string.IsNullOrEmpty(p.Name) && p.Name != p.Username)
                    {
                        <span style="color: #9ca3af; font-size: 0.875rem;">@p.Name</span>
                    }
                </label>
            }
        </div>
        <div style="margin-top: 1rem; display: flex; justify-content: flex-end; gap: 0.5rem;">
            <button class="btn-secondary" onclick="closeDialog('player-picker-dialog')">Annuller</button>
            <button class="btn-primary" onclick="applyPlayerSelection()">Vælg</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let activeTeamIndex = null;

        function openPlayerPicker(teamIndex) {
            activeTeamIndex = teamIndex;
            // Pre-check currently selected players
            const input = document.querySelector(`[name="Teams[${teamIndex}].PlayerInitials"]`);
            const current = input ? input.value.split(',').map(s => s.trim().toUpperCase()).filter(Boolean) : [];
            document.querySelectorAll('.player-checkbox').forEach(cb => {
                cb.checked = current.includes(cb.value.toUpperCase());
            });
            openDialog('player-picker-dialog');
        }

        function applyPlayerSelection() {
            if (activeTeamIndex === null) return;
            const checked = [...document.querySelectorAll('.player-checkbox:checked')].map(cb => cb.value);
            const input = document.querySelector(`[name="Teams[${activeTeamIndex}].PlayerInitials"]`);
            if (input) input.value = checked.join(', ');
            closeDialog('player-picker-dialog');
        }

        function openDialog(id) { document.getElementById(id).classList.add('open'); }
        function closeDialog(id) { document.getElementById(id).classList.remove('open'); }
        document.querySelectorAll('.dialog-overlay').forEach(d => {
            d.addEventListener('click', (e) => { if (e.target === d) d.classList.remove('open'); });
        });
    </script>
}
