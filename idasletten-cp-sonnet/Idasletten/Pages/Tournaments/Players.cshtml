@page "/tournaments/{id}/players"
@model Idasletten.Pages.Tournaments.PlayersModel
@{
    ViewData["Title"] = "Spillere";
    var t = Model.Tournament;
}

@if (t == null)
{
    <p>Turnering ikke fundet.</p>
    return;
}

<div class="page-header">
    <div>
        <div style="font-size: 0.875rem; color: #6b7280; margin-bottom: 0.25rem;">
            <a href="/tournaments/@t.Id" style="color: #6b7280; text-decoration: none;">@t.Name</a> /
        </div>
        <h1>Spillere</h1>
    </div>
    <button class="btn-primary" onclick="openDialog('add-player-dialog')">+ Tilføj spiller</button>
</div>

@if (!t.Players.Any())
{
    <p style="color: #6b7280;">Ingen spillere tilmeldt endnu.</p>
}
else
{
    <table class="scoreboard" style="max-width: 600px;">
        <thead>
            <tr>
                <th>Initialer</th>
                <th>Navn</th>
                <th>Score</th>
                <th>V</th>
                <th>N</th>
                <th>Kampe</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in t.Players.OrderByDescending(p => p.Score))
            {
                <tr>
                    <td><a href="/users/@p.UserId" style="font-weight: 500; text-decoration: none;">@p.Username</a></td>
                    <td style="color: #6b7280;">@p.Name</td>
                    <td>@p.Score.ToString("F0")</td>
                    <td>@p.WinCount</td>
                    <td>@p.LoseCount</td>
                    <td>@p.MatchCount</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.AvailableSeedTournaments.Any())
{
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
        <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem;">
            Tilføj spillere fra en tidligere turnering
        </h2>

        @if (Model.SelectedSeedTournament == null)
        {
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                @foreach (var st in Model.AvailableSeedTournaments)
                {
                    <form method="post" asp-page-handler="SelectSeed" style="display: inline;">
                        <input type="hidden" name="TournamentId" value="@t.Id" />
                        <input type="hidden" name="SeedTournamentId" value="@st.Id" />
                        <button type="submit" class="btn-secondary" style="font-size: 0.875rem;">@st.Name</button>
                    </form>
                }
            </div>
        }
        else
        {
            <div style="margin-bottom: 0.75rem;">
                <strong>Seed: @Model.SelectedSeedTournament.Name</strong>
                <span style="color: #9ca3af; font-size: 0.875rem; margin-left: 0.5rem;">(sorteret efter score)</span>
            </div>
            @foreach (var sp in Model.SeedPlayers)
            {
                var alreadyAdded = t.Players.Any(p => p.Username == sp.Username);
                <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.375rem 0; @(alreadyAdded ? "opacity: 0.5;" : "")">
                    <span style="font-weight: 500; @(alreadyAdded ? "text-decoration: line-through;" : "")">
                        @sp.Username
                    </span>
                    <span style="color: #6b7280; font-size: 0.875rem;">@sp.Name</span>
                    <span style="color: #9ca3af; font-size: 0.875rem;">Score: @sp.Score.ToString("F0")</span>
                    @if (!alreadyAdded)
                    {
                        <form method="post" asp-page-handler="AddFromSeed" style="display: inline;">
                            <input type="hidden" name="TournamentId" value="@t.Id" />
                            <input type="hidden" name="Username" value="@sp.Username" />
                            <button type="submit" class="btn-primary" style="font-size: 0.8rem; padding: 0.2rem 0.5rem;">+</button>
                        </form>
                    }
                    else
                    {
                        <span style="color: #16a34a; font-size: 0.8rem;">✓ Tilføjet</span>
                    }
                </div>
            }
        }
    </div>
}

<!-- Add Player Dialog -->
<div id="add-player-dialog" class="dialog-overlay">
    <div class="dialog-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">Tilføj spiller</h3>
            <button onclick="closeDialog('add-player-dialog')" style="background: none; border: none; cursor: pointer; font-size: 1.25rem;">×</button>
        </div>
        <form method="post" asp-page-handler="AddPlayer">
            <input type="hidden" name="TournamentId" value="@t.Id" />
            <div class="form-group">
                <label class="form-label">Initialer *</label>
                <input type="text" name="Username" class="form-input" placeholder="f.eks. ALK" required maxlength="10" style="text-transform: uppercase;" />
            </div>
            <div class="form-group">
                <label class="form-label">Navn (valgfrit)</label>
                <input type="text" name="Name" class="form-input" placeholder="Fuldt navn" />
            </div>
            <div style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem;">
                <button type="button" class="btn-secondary" onclick="closeDialog('add-player-dialog')">Annuller</button>
                <button type="submit" class="btn-primary">Tilføj</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openDialog(id) { document.getElementById(id).classList.add('open'); }
        function closeDialog(id) { document.getElementById(id).classList.remove('open'); }
        document.querySelectorAll('.dialog-overlay').forEach(d => {
            d.addEventListener('click', (e) => { if (e.target === d) d.classList.remove('open'); });
        });
    </script>
}
