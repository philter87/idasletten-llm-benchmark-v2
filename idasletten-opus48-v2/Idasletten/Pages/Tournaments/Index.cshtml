@page "/tournaments"
@model Idasletten.Pages.Tournaments.IndexModel
@{
    ViewData["Title"] = "Tournaments";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">All tournaments</h1>
    <a class="btn" asp-page="/Tournaments/Create">Create tournament</a>
</div>

@if (Model.Tournaments.Count == 0)
{
    <p class="text-muted-foreground">No tournaments have been fought yet.</p>
}
else
{
    <div class="overflow-x-auto rounded-md border">
        <table class="table w-full">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Scoring</th>
                    <th>Players</th>
                    <th>Visibility</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tournaments)
                {
                    <tr>
                        <td class="font-medium">
                            <a class="hover:underline" asp-page="/Tournaments/Detail" asp-route-id="@t.Id">@t.Name</a>
                        </td>
                        <td><span class="badge-secondary">@t.ScoreSystem</span></td>
                        <td>@t.PlayerCount</td>
                        <td>
                            @if (t.IsArchived)
                            {
                                <span class="badge-outline">Archived</span>
                            }
                            else if (t.IsPublic)
                            {
                                <span class="badge">Public</span>
                            }
                            else
                            {
                                <span class="badge-outline">Private</span>
                            }
                        </td>
                        <td class="text-right">
                            <a class="btn-sm-outline" asp-page="/Tournaments/Detail" asp-route-id="@t.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
