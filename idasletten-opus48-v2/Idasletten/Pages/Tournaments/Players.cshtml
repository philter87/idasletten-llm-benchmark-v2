@page "/tournaments/{tournamentId:guid}/players"
@model Idasletten.Pages.Tournaments.PlayersModel
@{
    var t = Model.Tournament;
    ViewData["Title"] = $"Players · {t.Name}";
}

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
        <a class="text-sm text-muted-foreground hover:underline" asp-page="/Tournaments/Detail" asp-route-id="@t.Id">← @t.Name</a>
        <h1 class="text-2xl font-bold">Players</h1>
    </div>
    <button type="button" class="btn" onclick="document.getElementById('add-player').showModal()">Add a player</button>
</div>

<div class="overflow-x-auto rounded-md border mb-10">
    <table class="table w-full">
        <thead>
            <tr><th>Initials</th><th>Name</th><th class="text-right">Matches</th><th class="text-right">Score</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Players)
            {
                <tr>
                    <td class="font-medium">@p.Initials</td>
                    <td class="text-muted-foreground">@p.Name</td>
                    <td class="text-right">@p.MatchCount</td>
                    <td class="text-right tabular-nums">@p.Score.ToString("0.#")</td>
                </tr>
            }
            @if (Model.Players.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted-foreground py-6">No players yet.</td></tr>
            }
        </tbody>
    </table>
</div>

<section>
    <h2 class="text-lg font-semibold mb-3">Add players based on a previous tournament</h2>

    @if (Model.SelectedSeedId is null)
    {
        @if (Model.PreviousTournaments.Count == 0)
        {
            <p class="text-muted-foreground text-sm">No previous tournaments to draw from.</p>
        }
        else
        {
            <details class="relative">
                <summary class="btn-outline inline-flex cursor-pointer list-none">Choose a tournament ▾</summary>
                <div class="card mt-2 p-2 flex flex-col gap-1 w-72">
                    @foreach (var prev in Model.PreviousTournaments)
                    {
                        <a class="px-2 py-1 rounded hover:bg-muted no-underline"
                           asp-page="/Tournaments/Players" asp-route-tournamentId="@t.Id" asp-route-seedId="@prev.Id">@prev.Name</a>
                    }
                </div>
            </details>
        }
    }
    else
    {
        <div class="overflow-x-auto rounded-md border max-w-xl">
            <table class="table w-full">
                <thead><tr><th>#</th><th>Player</th><th class="text-right">Score</th><th></th></tr></thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var c in Model.SeedPlayers)
                    {
                        <tr>
                            <td class="text-muted-foreground">@rank</td>
                            <td class="@(c.AlreadyAdded ? "struck" : "")">
                                <span class="font-medium">@c.Initials</span> <span class="text-muted-foreground text-xs">@c.Name</span>
                            </td>
                            <td class="text-right tabular-nums">@c.Score.ToString("0.#")</td>
                            <td class="text-right">
                                @if (c.AlreadyAdded)
                                {
                                    <span class="text-muted-foreground">✓</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="AddFromSeed" asp-route-tournamentId="@t.Id"
                                          asp-route-seedId="@Model.SelectedSeedId" asp-route-userId="@c.UserId" class="inline">
                                        <button type="submit" class="btn-sm">+</button>
                                    </form>
                                }
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<dialog id="add-player" class="dialog">
    <article>
        <header><h2 class="text-lg font-semibold">Add player</h2></header>
        <form method="post" asp-page-handler="AddPlayer" asp-route-tournamentId="@t.Id" class="flex flex-col gap-3 mt-3">
            <div class="grid gap-1">
                <label class="label">Initials</label>
                <input type="text" class="input" name="Initials" maxlength="8" placeholder="THO" required />
            </div>
            <div class="grid gap-1">
                <label class="label">Name (optional)</label>
                <input type="text" class="input" name="PlayerName" placeholder="Thor" />
            </div>
            <footer class="flex justify-end gap-2 mt-2">
                <button type="button" class="btn-outline" onclick="document.getElementById('add-player').close()">Cancel</button>
                <button type="submit" class="btn">Add</button>
            </footer>
        </form>
    </article>
</dialog>
