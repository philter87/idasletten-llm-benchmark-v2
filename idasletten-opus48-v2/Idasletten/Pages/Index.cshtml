@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero p-8 mb-8">
    <div class="hero-quote text-lg leading-relaxed">
        <h1 class="text-3xl font-bold mb-3 not-italic">Idasletten</h1>
        “Idasletten (Iðavöllr) findes i nordisk mytologi lige uden for Valhals porte. Det er her
        vikingerne som er døde i krig udkæmper deres drabelige slag hver dag, som øvelse til Ragnarok.
        Hver aften er Idasletten rød af blod.”
    </div>
</section>

<div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-semibold">Public tournaments</h2>
</div>

@if (Model.PublicTournaments.Count == 0)
{
    <p class="text-muted-foreground">No public tournaments yet. Check back before the next battle.</p>
}
else
{
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var t in Model.PublicTournaments)
        {
            <a class="card no-underline hover:shadow-md transition-shadow" asp-page="/Tournaments/Detail" asp-route-id="@t.Id">
                <div class="card-header">
                    <h3 class="card-title">@t.Name</h3>
                    <p class="card-description">@t.PlayerCount players · @t.ScoreSystem</p>
                </div>
                <div class="card-footer">
                    <span class="badge-secondary">@t.ScoreSystem</span>
                </div>
            </a>
        }
    </div>
}

<div class="mt-8 text-sm">
    <a class="text-muted-foreground hover:underline" asp-page="/Tournaments/Index">Browse historical tournaments →</a>
</div>
