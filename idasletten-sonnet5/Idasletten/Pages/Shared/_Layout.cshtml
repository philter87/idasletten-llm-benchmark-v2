<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Idasletten</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.1/dist/basecoat.cdn.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.1/dist/js/all.min.js" defer></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-background text-foreground">
    <header class="border-b">
        <div class="flex items-center justify-between gap-4 p-4 max-w-5xl mx-auto w-full">
            <a href="/" class="font-semibold text-lg">Idasletten</a>
            <nav class="flex items-center gap-2">
                <a href="/tournaments" class="btn" data-variant="ghost" data-size="sm">Turneringer</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-sm text-muted-foreground">@User.Identity!.Name</span>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn" data-variant="outline" data-size="sm">Log ud</button>
                    </form>
                }
                else
                {
                    <a href="/login" class="btn" data-variant="outline" data-size="sm">Log ind</a>
                }
            </nav>
        </div>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto p-4">
        @RenderBody()
    </main>

    <footer class="border-t text-sm text-muted-foreground">
        <div class="max-w-5xl mx-auto p-4">
            Idasletten &mdash; til ære for Odin
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
