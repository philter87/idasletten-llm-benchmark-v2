@page
@{
    ViewData["Title"] = "Access Denied - Idasletten";
}

<div class="card" style="max-width: 600px; margin: 2rem auto; text-align: center;">
    <h2 class="card-title" style="color: #f44336;">❌ Access Denied</h2>
    <p style="color: #666; margin: 1rem 0;">
        You need to be logged in to access this page.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
        <a asp-page="/Account/Login" class="btn btn-primary">Sign In</a>
        <a asp-page="/" class="btn btn-secondary">Return Home</a>
    </div>
</div>
