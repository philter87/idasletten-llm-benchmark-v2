@page
@model Account.LoginModel
@{
    ViewData["Title"] = "Login - Idasletten";
}

<div class="card" style="max-width: 450px; margin: 2rem auto;">
    <h2 class="card-title" style="text-align: center;">Login to Idasletten</h2>
    
    @if (!string.IsNullOrEmpty(Model.ExternalLoginError))
    {
        <div style="color: #f44336; background: #ffebee; padding: 1rem; border-radius: 4px; margin: 1rem 0;">
            @Model.ExternalLoginError
        </div>
    }
    
    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
    {
        <div style="color: #666; margin-bottom: 1rem; text-align: center;">
            <small>You need to login to continue to: @Model.ReturnUrl</small>
        </div>
    }
    
    <form method="post" style="display: flex; flex-direction: column; gap: 1rem;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        @if (Model.TestUserEnabled)
        {
            <div style="margin: 1rem 0;">
                <h3 style="color: #1a237e; margin: 0 0 1rem 0;">Test User Login</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div>
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" 
                               style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" 
                               style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" name="testLogin" value="true" class="btn btn-primary" style="margin-top: 1rem;">
                    Login with Test User
                </button>
            </div>
            
            <div style="text-align: center; margin: 1rem 0; color: #999;">OR</div>
        }
        
        <button type="submit" name="provider" value="Microsoft" class="btn btn-primary" 
                style="background: linear-gradient(135deg, #1a237e 0%, #3949ab 100%); padding: 1rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1" y="1" width="10" height="10" fill="#F2C811"/>
                <rect x="1" y="13" width="10" height="10" fill="#00A4EF"/>
                <rect x="13" y="1" width="10" height="10" fill="#E81123"/>
                <rect x="13" y="13" width="10" height="10" fill="#7FBA00"/>
            </svg>
            Sign in with Microsoft
        </button>
    </form>
    
    <div style="margin-top: 1.5rem; text-align: center; color: #666; font-size: 0.875rem;">
        <p>No account? Creating a tournament will prompt you to sign in via Microsoft.</p>
        @if (Model.TestUserEnabled)
        {
            <p><small>Test user credentials are configured for development.</small></p>
        }
    </div>
</div>
