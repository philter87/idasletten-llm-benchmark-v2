@page
@model Idasletten.Pages.ErrorModel
@{
    ViewData["Title"] = "Error - Idasletten";
}

<div class="card" style="max-width: 600px; margin: 2rem auto; text-align: center;">
    @if (Model.ErrorCode == 404)
    {
        <h2 class="card-title" style="color: #f44336; font-size: 4rem; margin: 0;">404</h2>
        <h3 style="margin: 1rem 0 0 0;">Page Not Found</h3>
    }
    else if (Model.ErrorCode == 403)
    {
        <h2 class="card-title" style="color: #ff9800; font-size: 4rem; margin: 0;">403</h2>
        <h3 style="margin: 1rem 0 0 0;">Forbidden</h3>
    }
    else
    {
        <h2 class="card-title" style="color: #f44336; font-size: 4rem; margin: 0;">Error</h2>
        <h3 style="margin: 1rem 0 0 0;">Something went wrong</h3>
    }
    
    <p style="color: #666; margin: 1rem 0; line-height: 1.5;">
        @Model.ErrorMessage
    </p>
    
    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
        <a asp-page="/" class="btn btn-primary">Return Home</a>
        <a asp-page="/Tournaments" class="btn btn-secondary">Browse Tournaments</a>
    </div>
</div>
