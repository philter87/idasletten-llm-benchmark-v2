@page "{tournamentId:guid}"
@model CreateMatchModel
@{
    ViewData["Title"] = "@Model.TournamentName - Opret Kamp";
}

<div class="bc-grid">
    <div class="bc-grid__item bc-grid__item--1">
        <form method="post" class="bc-form">
            <input type="hidden" name="TournamentId" value="@Model.TournamentId" />
            <input type="hidden" name="MatchId" value="@Model.Command.MatchId" />
            
            <h2>@(Model.Command.MatchId == Guid.Empty ? "Opret kamp" : "Rediger kamp") - @Model.TournamentName</h2>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="bc-alert bc-alert--danger">@Model.ErrorMessage</div>
            }

            <div class="bc-form-group">
                <label class="bc-form-label">
                    <strong>Hold 1</strong> @if (Model.Command.MatchId != Guid.Empty) { <span>(Nuværende: @string.Join(", ", Model.CurrentMatch?.Teams.FirstOrDefault()?.Players.Select(p => p.User.UserName) ?? new List<string>()))</span> }
                </label>
                
                <div class="team-input">
                    @for (int i = 0; i < Model.TournamentTeamSize; i++)
                    {
                        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                            <input type="text" name="Team1Initials[@i]" class="bc-form-input" 
                                   placeholder="Initialer (3 bogstaver)" 
                                   value="@GetTeam1Initials(i)" maxlength="3" pattern="[A-Za-z]{3}" />
                            <button type="button" class="bc-btn bc-btn--secondary bc-btn--small" 
                                    onclick="selectPlayer('team1', @i)">
                                Vælg spiller
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="bc-form-group">
                <label class="bc-form-label">
                    <strong>Hold 2</strong> @if (Model.Command.MatchId != Guid.Empty) { <span>(Nuværende: @string.Join(", ", Model.CurrentMatch?.Teams.Skip(1).FirstOrDefault()?.Players.Select(p => p.User.UserName) ?? new List<string>()))</span> }
                </label>
                
                <div class="team-input">
                    @for (int i = 0; i < Model.TournamentTeamSize; i++)
                    {
                        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                            <input type="text" name="Team2Initials[@i]" class="bc-form-input" 
                                   placeholder="Initialer (3 bogstaver)" 
                                   value="@GetTeam2Initials(i)" maxlength="3" pattern="[A-Za-z]{3}" />
                            <button type="button" class="bc-btn bc-btn--secondary bc-btn--small" 
                                    onclick="selectPlayer('team2', @i)">
                                Vælg spiller
                            </button>
                        </div>
                    }
                </div>
            </div>

            @if (Model.TournamentTeamSize > 2)
            {
                @for (int teamNum = 3; teamNum <= Model.TournamentTeamSize; teamNum++)
                {
                    <div class="bc-form-group">
                        <label class="bc-form-label"><strong>Hold @teamNum</strong></label>
                        <div class="team-input">
                            @for (int i = 0; i < Model.TournamentTeamSize; i++)
                            {
                                <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                                    <input type="text" name="Team@(teamNum)Initials[@i]" class="bc-form-input" 
                                           placeholder="Initialer (3 bogstaver)" maxlength="3" pattern="[A-Za-z]{3}" />
                                    <button type="button" class="bc-btn bc-btn--secondary bc-btn--small" 
                                            onclick="selectPlayer('team@(teamNum)', @i)">
                                        Vælg spiller
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            <div class="bc-grid">
                <div class="bc-grid__item bc-grid__item--1-2">
                    <div class="bc-form-group">
                        <label for="Team1Goals" class="bc-form-label">Hold 1 mål</label>
                        <input type="number" id="Team1Goals" name="Team1Goals" class="bc-form-input" 
                               min="0" value="@Model.Command.Team1Goals" />
                    </div>
                </div>
                <div class="bc-grid__item bc-grid__item--1-2">
                    <div class="bc-form-group">
                        <label for="Team2Goals" class="bc-form-label">Hold 2 mål</label>
                        <input type="number" id="Team2Goals" name="Team2Goals" class="bc-form-input" 
                               min="0" value="@Model.Command.Team2Goals" />
                    </div>
                </div>
            </div>

            @if (Model.Command.MatchId != Guid.Empty && Model.CurrentMatch != null)
            {
                <div class="bc-form-group">
                    <label class="bc-form-label">
                        <input type="checkbox" name="OverwriteCompletedMatch" @(Model.Command.OverwriteCompletedMatch ? "checked" : "") />
                        Tillad redigering af afsluttet kamp (kræver login)
                    </label>
                </div>
            }

            <div class="bc-form-actions">
                <button type="submit" class="bc-btn bc-btn--primary">
                    <i class="fas fa-save"></i> @(Model.Command.MatchId == Guid.Empty ? "Gem kamp" : "Opdater kamp")
                </button>
                <a href="/tournaments/@Model.TournamentId" class="bc-btn bc-btn--secondary">Annuller</a>
            </div>
        </form>
    </div>
</div>

<!-- Player Selection Modal -->
<div id="playerSelectionModal" class="bc-modal" style="display: none;">
    <div class="bc-modal__content" style="max-width: 600px;">
        <h3>Vælg spiller</h3>
        <div id="playerSelectionContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        function selectPlayer(teamName, index) {
            const modal = document.getElementById('playerSelectionModal');
            const content = document.getElementById('playerSelectionContent');
            
            // Get all players from the tournament
            const players = @Html.Raw(Json.Serialize(Model.AvailablePlayers.Select(p => new { p.User.UserName, p.User.Name, p.User.Id })));
            
            if (players.length === 0) {
                alert('Der er ingen spillere tilføjet til turneringen endnu.');
                return;
            }
            
            let html = '<form id="selectPlayerForm">';
            html += '<div style="max-height: 400px; overflow-y: auto; margin-bottom: 1rem;">';
            
            players.forEach(player => {
                html += `<div style="padding: 0.5rem; border-bottom: 1px solid #eee;">`;
                html += `<label style="display: flex; align-items: center; cursor: pointer;">`;
                html += `<input type="radio" name="selectedPlayer" value="${player.userName}" style="margin-right: 1rem;">`;
                html += `<strong>${player.userName}</strong>`;
                if (player.name) {
                    html += ` (${player.name})`;
                }
                html += `</label>`;
                html += `</div>`;
            });
            
            html += '</div>';
            html += '<input type="hidden" name="teamName" value="' + teamName + '">';
            html += '<input type="hidden" name="index" value="' + index + '">';
            html += '<button type="submit" class="bc-btn bc-btn--primary">Vælg</button>';
            html += '<button type="button" onclick="closePlayerModal()" class="bc-btn bc-btn--secondary" style="margin-left: 1rem;">Annuller</button>';
            html += '</form>';
            
            content.innerHTML = html;
            modal.style.display = 'block';
        }
        
        function closePlayerModal() {
            document.getElementById('playerSelectionModal').style.display = 'none';
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            // Handle player selection form submission
            document.addEventListener('submit', function(e) {
                if (e.target && e.target.id === 'selectPlayerForm') {
                    e.preventDefault();
                    const form = e.target;
                    const selectedPlayer = form.querySelector('input[name="selectedPlayer"]:checked');
                    const teamName = form.querySelector('input[name="teamName"]').value;
                    const index = form.querySelector('input[name="index"]').value;
                    
                    if (selectedPlayer) {
                        const inputName = `${teamName}Initials[${index}]`;
                        const input = document.querySelector(`input[name="${inputName}"]`);
                        if (input) {
                            input.value = selectedPlayer.value;
                        }
                        closePlayerModal();
                    }
                }
            });
        });
        
        // Auto-create user from initials if not exists
        function setupAutoCreate() {
            const initialsInputs = document.querySelectorAll('input[name^="Team"][name$="Initials"]');
            initialsInputs.forEach(input => {
                input.addEventListener('blur', async function() {
                    const value = this.value.trim().toUpperCase();
                    if (value.length === 3 && /^[A-Z]{3}$/.test(value)) {
                        // Check if user exists - for now just leave as is
                        // The server will handle creating users from initials
                    }
                });
            });
        }
        
        // Call on page load
        setupAutoCreate();
    </script>
}

@functions {
    string GetTeam1Initials(int index)
    {
        if (Model.Command.Team1Initials != null && Model.Command.Team1Initials.Length > index)
        {
            return Model.Command.Team1Initials[index];
        }
        return string.Empty;
    }
    
    string GetTeam2Initials(int index)
    {
        if (Model.Command.Team2Initials != null && Model.Command.Team2Initials.Length > index)
        {
            return Model.Command.Team2Initials[index];
        }
        return string.Empty;
    }
}
