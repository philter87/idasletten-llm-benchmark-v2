@page
@model Tournaments.IndexModel
@{
    ViewData["Title"] = "All Tournaments";
}

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 class="card-title" style="margin: 0;">All Tournaments</h2>
        @if (User.Identity.IsAuthenticated)
        {
            <a asp-page="/Tournaments/Create" class="btn btn-primary">➕ Create Tournament</a>
        }
    </div>
    
    <p style="color: #666; margin-bottom: 1.5rem;">
        Browse all tournaments, including archived and private ones.
    </p>
    
    <div style="margin-bottom: 1rem;">
        <a asp-page="/" style="color: #1a237e; text-decoration: none;">← Back to Home</a>
    </div>
    
    @if (Model.Tournaments.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Players</th>
                    <th>Matches</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tournament in Model.Tournaments)
                {
                    <tr>
                        <td>
                            <strong>
                                @if (tournament.ParentTournamentId.HasValue)
                                {
                                    @for (int i = 0; i < (tournament.RoundNumber ?? 1) - 1; i++)
                                    {
                                        <span style="margin-right: 0.5rem;">→</span>
                                    }
                                }
                                <a asp-page="/Tournaments/Detail" asp-route-id="@tournament.Id" style="color: #1a237e; text-decoration: none;">
                                    @tournament.Name
                                </a>
                            </strong>
                            @if (tournament.ParentTournamentId.HasValue)
                            {
                                <div style="font-size: 0.75rem; color: #999;">
                                    Round @(tournament.RoundNumber ?? 1)
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge badge-info">@tournament.ScoreSystem</span>
                        </td>
                        <td>@tournament.TournamentPlayers.Count</td>
                        <td>@tournament.Matches.Count</td>
                        <td>
                            @if (tournament.IsArchived)
                            {
                                <span class="badge badge-danger">Archived</span>
                            }
                            else if (tournament.IsPublic)
                            {
                                <span class="badge badge-success">Public</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Private</span>
                            }
                        </td>
                        <td>@tournament.CreatedAt.ToShortDateString()</td>
                        <td>
                            <a asp-page="/Tournaments/Detail" asp-route-id="@tournament.Id" class="btn btn-secondary" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">View</a>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-page="/Tournaments/Players" asp-route-id="@tournament.Id" class="btn btn-secondary" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Players</a>
                                <a asp-page="/Tournaments/Matches" asp-route-id="@tournament.Id" class="btn btn-secondary" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Matches</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color: #999; text-align: center; padding: 2rem;">
            No tournaments found. @if (User.Identity.IsAuthenticated) { <a asp-page="/Tournaments/Create">Create your first tournament</a>. }
        </p>
    }
</div>
