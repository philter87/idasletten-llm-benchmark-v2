@page
@model DetailModel
@{
    ViewData["Title"] = "@Model.Tournament.Name - Idasletten";
}

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h2 class="card-title" style="margin: 0;">@Model.Tournament.Name</h2>
            <div style="margin-top: 0.5rem; color: #666;">
                <span class="badge badge-info">@Model.Tournament.ScoreSystem</span>
                <span class="badge badge-info">@Model.Tournament.TeamSize Players/Team</span>
                <span class="badge badge-info">@Model.Tournament.PointsToWin Points to Win</span>
                @if (Model.Tournament.IsArchived)
                {
                    <span class="badge badge-danger">Archived</span>
                }
                @if (!Model.Tournament.IsPublic)
                {
                    <span class="badge badge-warning">Private</span>
                }
            </div>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-page="/Tournaments/CreateMatch" asp-route-tournamentId="@Model.Tournament.Id" class="btn btn-primary">
                    ➕ Create Match
                </a>
                <a asp-page="/Tournaments/Players" asp-route-id="@Model.Tournament.Id" class="btn btn-secondary">
                    Manage Players
                </a>
                <a asp-page="/Tournaments/Matches" asp-route-id="@Model.Tournament.Id" class="btn btn-secondary">
                    View All Matches
                </a>
            }
            <a asp-page="/Tournaments" class="btn btn-secondary" style="color: #666;">Back to List</a>
        </div>
    </div>
</div>

<!-- Main Content Area -->
<div class="flex-row" style="gap: 2rem;">
    <!-- Main Area - Scoreboard -->
    <div class="main-content">
        <div class="card">
            <h3 class="card-title">Scoreboard</h3>
            
            @if (Model.Tournament.TournamentPlayers.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Player</th>
                            <th>Score</th>
                            <th>Wins</th>
                            <th>Losses</th>
                            <th>Matches</th>
                            <th>Δ</th>
                            @if (Model.Tournament.ScoreSystem == ScoreSystem.Lives)
                            {
                                <th>Lives</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Tournament.TournamentPlayers.OrderByDescending(p => p.Score).ThenByDescending(p => p.ScoreDiff))
                        {
                            <tr>
                                <td>@(Model.Tournament.TournamentPlayers.OrderByDescending(p => p.Score).ThenByDescending(p => p.ScoreDiff).ToList().IndexOf(player) + 1)</td>
                                <td>
                                    <strong>@player.User.UserName</strong>
                                    @if (!string.IsNullOrEmpty(player.User.Name))
                                    {
                                        <div style="font-size: 0.75rem; color: #999;">@player.User.Name</div>
                                    }
                                </td>
                                <td>@player.Score.ToString("N2")</td>
                                <td>@player.WinCount</td>
                                <td>@player.LoseCount</td>
                                <td>@player.MatchCount</td>
                                <td class="@(player.ScoreDiff >= 0 ? "score-diff-positive" : "score-diff-negative")">
                                    @(player.ScoreDiff >= 0 ? "+" : "")@player.ScoreDiff.ToString("N2")
                                </td>
                                @if (Model.Tournament.ScoreSystem == ScoreSystem.Lives)
                                {
                                    <td>@player.Lives</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: #999; text-align: center; padding: 2rem;">
                    No players in this tournament. 
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-page="/Tournaments/Players" asp-route-id="@Model.Tournament.Id">Add players</a>
                    }
                </p>
            }
        </div>
    </div>
    
    <!-- Sidebar - Next and Recent Matches -->
    <div class="sidebar">
        <!-- Create Match Button (already shown above) -->
        
        <!-- Next Planned Matches -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h3 class="card-title" style="margin: 0;">Next Matches</h3>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-page="/Tournaments/CreateMatch" asp-route-tournamentId="@Model.Tournament.Id" 
                       style="font-size: 0.875rem; color: #1a237e; text-decoration: none;">
                        + Add
                    </a>
                }
            </div>
            
            @if (Model.NextMatches.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    @foreach (var match in Model.NextMatches)
                    {
                        <a asp-page="/Tournaments/CreateMatch" asp-route-tournamentId="@Model.Tournament.Id" asp-route-matchId="@match.Id"
                           class="card" style="box-shadow: none; border: 1px solid #e0e0e0; padding: 0.75rem; cursor: pointer; transition: all 0.3s;">
                            <div style="font-size: 0.75rem; color: #999; margin-bottom: 0.25rem;">
                                Match #@match.Order
                            </div>
                            <div style="font-size: 0.875rem;">
                                @foreach (var team in match.Teams.OrderBy(t => t.Number))
                                {
                                    <span style="color: @GetTeamColor(team.Number);">
                                        @(team.Number == 1 ? "🔴" : "🔵") @string.Join(" + ", team.Players.Select(p => p.User.UserName))
                                    </span>
                                    @if (team.Number < match.Teams.Count)
                                    {
                                        <span style="color: #999;"> vs </span>
                                    }
                                }
                            </div>
                            <div style="font-size: 0.75rem; color: #999; margin-top: 0.25rem;">
                                <span class="badge badge-secondary">Planned</span>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p style="color: #999; font-size: 0.875rem; text-align: center;">
                    No planned matches
                </p>
            }
        </div>
        
        <!-- Recent Played Matches -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h3 class="card-title" style="margin: 0;">Recent Matches</h3>
                <a asp-page="/Tournaments/Matches" asp-route-id="@Model.Tournament.Id" 
                   style="font-size: 0.875rem; color: #1a237e; text-decoration: none;">
                    All Matches
                </a>
            </div>
            
            @if (Model.RecentMatches.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    @foreach (var match in Model.RecentMatches)
                    {
                        <div class="card" style="box-shadow: none; border: 1px solid #e0e0e0; padding: 0.75rem;">
                            <div style="font-size: 0.75rem; color: #999; margin-bottom: 0.25rem;">
                                Match #@match.Order
                            </div>
                            <div style="font-size: 0.875rem;">
                                @foreach (var result in match.Results.OrderBy(r => r.Team.Number))
                                {
                                    <span style="color: @GetTeamColor(result.Team.Number);">
                                        @(result.Team.Number == 1 ? "🔴" : "🔵") 
                                        @string.Join(" + ", result.Team.Players.Select(p => p.User.UserName))
                                        <strong>@result.GoalsWon</strong>
                                    </span>
                                    @if (result.Team.Number < match.Results.Count)
                                    {
                                        <span style="color: #999;"> - </span>
                                    }
                                }
                            </div>
                            <div style="font-size: 0.75rem; color: #999; margin-top: 0.25rem;">
                                <span class="badge badge-success">@match.State</span>
                                @if (match.CompletedAt.HasValue)
                                {
                                    <span style="margin-left: 0.5rem;">@match.CompletedAt.Value.ToShortDateString()</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color: #999; font-size: 0.875rem; text-align: center;">
                    No matches played yet
                </p>
            }
        </div>
    </div>
</div>

@functions {
    string GetTeamColor(int teamNumber)
    {
        return teamNumber == 1 ? "#f44336" : "#2196f3";
    }
}
