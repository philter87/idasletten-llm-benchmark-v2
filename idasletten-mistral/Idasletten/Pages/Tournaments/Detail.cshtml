@page "{tournamentId:guid}"
@model DetailModel
@{
    ViewData["Title"] = "@Model.Tournament.Name - Idasletten";
}

<div class="bc-grid">
    <div class="bc-grid__item bc-grid__item--3-4">
        <div class="scoreboard">
            <h2>Scoreboard - @Model.Tournament.Name</h2>
            <p>
                <strong>Scoring:</strong> @Model.Tournament.ScoreSystem 
                | <strong>Holdstørrelse:</strong> @Model.Tournament.TeamSize 
                | <strong>Point til sejr:</strong> @Model.Tournament.PointsToWin
            </p>
            
            @if (Model.Players.Any())
            {
                <table class="scoreboard-table">
                    <thead>
                        <tr>
                            <th>Plads</th>
                            <th>Spiller</th>
                            <th>Kampe</th>
                            <th>Vundne</th>
                            <th>Tabte</th>
                            <th>Point</th>
                            <th>Delta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Players.OrderByDescending(p => p.Score).ThenByDescending(p => p.WinCount))
                        {
                            <tr>
                                <td>@(Model.Players.OrderByDescending(p => p.Score).ThenByDescending(p => p.WinCount).ToList().IndexOf(player) + 1)</td>
                                <td>
                                    <a href="/users/@player.UserId">@player.User.UserName</a>
                                    @if (!string.IsNullOrEmpty(player.User.Name))
                                    {
                                        <small>(@player.User.Name)</small>
                                    }
                                </td>
                                <td>@player.MatchCount</td>
                                <td>@player.WinCount</td>
                                <td>@player.LoseCount</td>
                                <td>@player.Score.ToString("F1")</td>
                                <td class="score-diff-@(player.ScoreDiff >= 0 ? "positive" : "negative")">
                                    @(player.ScoreDiff >= 0 ? "+" : "")@player.ScoreDiff.ToString("F1")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="bc-alert bc-alert--info">Ingen spillere tilføjet endnu.</p>
            }
            
            @if (User.Identity.IsAuthenticated)
            {
                <div style="margin-top: 1rem;">
                    <button onclick="openAddPlayerDialog()" class="bc-btn bc-btn--primary">
                        <i class="fas fa-plus"></i> Tilføj spiller
                    </button>
                </div>
            }
        </div>
        
        @if (Model.Matches.Any())
        {
            <div class="scoreboard" style="margin-top: 2rem;">
                <h3>Seneste kampe</h3>
                <table class="scoreboard-table">
                    <thead>
                        <tr>
                            <th>Dato</th>
                            <th>Hold</th>
                            <th>Resultat</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var match in Model.Matches.OrderByDescending(m => m.Order).Take(5))
                        {
                            <tr>
                                <td>@match.Order</td>
                                <td>
                                    @foreach (var team in match.Teams.Take(2))
                                    {
                                        <div>@team.Name: @string.Join(", ", team.Players.Select(p => p.User.UserName))</div>
                                    }
                                </td>
                                <td>
                                    @foreach (var result in match.Results.Take(2))
                                    {
                                        <div>@result.GoalsWon - @result.GoalsLost</div>
                                    }
                                </td>
                                <td><span class="match-state-@MatchStateClass(match.State)">@match.State</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    
    <div class="bc-grid__item bc-grid__item--1-4">
        <div class="tournament-card">
            <h3>Turnerings info</h3>
            <p><strong>Navn:</strong> @Model.Tournament.Name</p>
            <p><strong>Oprettet:</strong> @Model.Tournament.Id.ToString()[..8]...</p>
            <p><strong>Status:</strong> @(Model.Tournament.IsArchived ? "Afsluttet" : "Aktiv")</p>
            <p><strong>Synlighed:</strong> @(Model.Tournament.IsPublic ? "Offentlig" : "Privat")</p>
            
            @if (Model.Tournament.MaxPlayerCount.HasValue)
            {
                <p><strong>Maks spillere:</strong> @Model.Tournament.MaxPlayerCount</p>
            }
        </div>
        
        @if (User.Identity.IsAuthenticated)
        {
            <div class="tournament-card">
                <h3>Aktioner</h3>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <a href="/tournaments/@Model.Tournament.Id/create-match" class="bc-btn bc-btn--primary bc-btn--small">
                        Opret kamp
                    </a>
                    <a href="/tournaments/@Model.Tournament.Id/matches" class="bc-btn bc-btn--secondary bc-btn--small">
                        Alle kampe
                    </a>
                    <a href="/tournaments/@Model.Tournament.Id/players" class="bc-btn bc-btn--secondary bc-btn--small">
                        Spillere
                    </a>
                    @if (!Model.Tournament.IsArchived)
                    {
                        <a href="/tournaments/@Model.Tournament.Id/edit" class="bc-btn bc-btn--secondary bc-btn--small">
                            Rediger
                        </a>
                    }
                </div>
            </div>
            
            <div class="tournament-card">
                <h3>Planlagte kampe</h3>
                @if (Model.PlannedMatches.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        @foreach (var match in Model.PlannedMatches.OrderBy(m => m.Order).Take(5))
                        {
                            <a href="/tournaments/@Model.Tournament.Id/create-match?matchId=@match.Id" 
                               class="bc-btn bc-btn--small bc-btn--secondary" style="text-align: left;">
                                Kamp @match.Order: @string.Join(" vs ", match.Teams.Take(2).Select(t => string.Join(", ", t.Players.Select(p => p.User.UserName))))
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p><em>Ingen planlagte kampe</em></p>
                }
            </div>
            
            <div class="tournament-card">
                <h3>Seneste kampe</h3>
                @if (Model.RecentMatches.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        @foreach (var match in Model.RecentMatches.OrderByDescending(m => m.Order).Take(5))
                        {
                            <a href="/tournaments/@Model.Tournament.Id/matches/@match.Id" 
                               class="bc-btn bc-btn--small bc-btn--secondary" style="text-align: left;">
                                Kamp @match.Order
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p><em>Ingen seneste kampe</em></p>
                }
            </div>
        }
    </div>
</div>

<!-- Add Player Dialog -->
<div id="addPlayerDialog" class="bc-modal" style="display: none;">
    <div class="bc-modal__content">
        <h3>Tilføj spiller</h3>
        <form id="addPlayerForm" method="post">
            <div class="form-group">
                <label for="playerInitials">Initialer (3 bogstaver)</label>
                <input type="text" id="playerInitials" class="form-control" 
                       maxlength="3" required pattern="[A-Za-z]{3}" />
            </div>
            <div class="form-group">
                <label for="playerName">Navn (valgfrit)</label>
                <input type="text" id="playerName" class="form-control" />
            </div>
            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button type="submit" class="bc-btn bc-btn--primary">Tilføj</button>
                <button type="button" onclick="closeAddPlayerDialog()" class="bc-btn bc-btn--secondary">Annuller</button>
            </div>
        </form>
    </div>
</div>

@functions {
    string MatchStateClass(MatchState state)
    {
        return state.ToString().ToLower();
    }
}

@section Scripts {
    <script>
        function openAddPlayerDialog() {
            document.getElementById('addPlayerDialog').style.display = 'block';
        }
        
        function closeAddPlayerDialog() {
            document.getElementById('addPlayerDialog').style.display = 'none';
        }
        
        document.getElementById('addPlayerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const initials = document.getElementById('playerInitials').value;
            const name = document.getElementById('playerName').value;
            
            try {
                const response = await fetch('/tournaments/@Model.Tournament.Id/players/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ initials, name })
                });
                
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Fejl ved tilføjelse af spiller');
                }
            } catch (error) {
                alert('Fejl: ' + error.message);
            }
        });
    </script>
}
