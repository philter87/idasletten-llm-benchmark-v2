@page
@model PlayersModel
@{
    ViewData["Title"] = "Players - @Model.Tournament.Name";
}

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h2 class="card-title" style="margin: 0;">@Model.Tournament.Name - Players</h2>
            <div style="color: #666; font-size: 0.875rem; margin-top: 0.25rem;">
                @Model.Tournament.TournamentPlayers.Count players total
            </div>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a asp-page="/Tournaments/Detail" asp-route-id="@Model.Tournament.Id" class="btn btn-secondary">Back to Tournament</a>
            @if (User.Identity.IsAuthenticated)
            {
                <button type="button" onclick="showAddPlayerDialog()" class="btn btn-primary">➕ Add Player</button>
            }
        </div>
    </div>
</div>

<div class="flex-row" style="gap: 2rem;">
    <!-- Players Table -->
    <div class="main-content">
        <div class="card">
            <h3 class="card-title">Current Players</h3>
            
            @if (Model.Tournament.TournamentPlayers.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Initials</th>
                            <th>Name</th>
                            <th>Score</th>
                            <th>Wins</th>
                            <th>Matches</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Tournament.TournamentPlayers.OrderByDescending(p => p.Score))
                        {
                            <tr>
                                <td><strong>@player.User.UserName</strong></td>
                                <td>@player.User.Name ?? "-"</td>
                                <td>@player.Score.ToString("N2")</td>
                                <td>@player.WinCount</td>
                                <td>@player.MatchCount</td>
                                <td>
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <button type="button" onclick="removePlayer('@player.Id')" 
                                                class="btn btn-danger" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">
                                            Remove
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: #999; text-align: center; padding: 2rem;">
                    No players in this tournament yet.
                </p>
            }
        </div>
    </div>
    
    <!-- Add Players from Previous Tournament -->
    <div class="sidebar">
        <div class="card">
            <h3 class="card-title">Add from Previous Tournament</h3>
            
            @if (Model.PreviousTournaments.Any())
            {
                <select id="seedTournamentSelect" onchange="loadTournamentPlayers(this.value)" 
                        style="width: 100%; padding: 0.5rem; margin-bottom: 1rem; border: 1px solid #ddd; border-radius: 4px;">
                    <option value="">-- Select a Tournament --</option>
                    @foreach (var tournament in Model.PreviousTournaments)
                    {
                        <option value="@tournament.Id">@tournament.Name (@tournament.TournamentPlayers.Count players)</option>
                    }
                </select>
                
                <div id="previousTournamentPlayers" style="max-height: 400px; overflow-y: auto;"></div>
            }
            else
            {
                <p style="color: #999; font-size: 0.875rem;">
                    No previous tournaments available.
                </p>
            }
        </div>
    </div>
</div>

<!-- Add Player Dialog -->
<div id="addPlayerDialog" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
    <div class="card" style="max-width: 500px; margin: 2rem;">
        <h3 class="card-title">Add Player</h3>
        <form id="addPlayerForm" method="post" style="display: flex; flex-direction: column; gap: 1rem;">
            <input type="hidden" name="tournamentId" value="@Model.Tournament.Id" />
            
            <div>
                <label for="playerInitials" class="form-label">Initials (3 letters) *</label>
                <input type="text" id="playerInitials" name="initials" required 
                       maxlength="10" 
                       style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" />
            </div>
            
            <div>
                <label for="playerName" class="form-label">Full Name (optional)</label>
                <input type="text" id="playerName" name="name" 
                       style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" />
            </div>
            
            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button type="submit" class="btn btn-primary">Add Player</button>
                <button type="button" onclick="hideAddPlayerDialog()" class="btn btn-secondary">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Remove Player Dialog -->
<div id="removePlayerDialog" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
    <div class="card" style="max-width: 400px; margin: 2rem; text-align: center;">
        <h3 class="card-title">Remove Player</h3>
        <p style="color: #666; margin: 1rem 0;">
            Are you sure you want to remove this player from the tournament?
        </p>
        <form id="removePlayerForm" method="post" style="display: flex; gap: 1rem; justify-content: center; margin-top: 1rem;">
            <input type="hidden" name="tournamentId" value="@Model.Tournament.Id" />
            <input type="hidden" id="removePlayerId" name="playerId" />
            <button type="submit" class="btn btn-danger">Yes, Remove</button>
            <button type="button" onclick="hideRemovePlayerDialog()" class="btn btn-secondary">Cancel</button>
        </form>
    </div>
</div>

<script>
    function showAddPlayerDialog() {
        document.getElementById('addPlayerDialog').style.display = 'flex';
    }
    
    function hideAddPlayerDialog() {
        document.getElementById('addPlayerDialog').style.display = 'none';
    }
    
    function removePlayer(playerId) {
        document.getElementById('removePlayerId').value = playerId;
        document.getElementById('removePlayerDialog').style.display = 'flex';
    }
    
    function hideRemovePlayerDialog() {
        document.getElementById('removePlayerDialog').style.display = 'none';
    }
    
    function loadTournamentPlayers(tournamentId) {
        if (!tournamentId) {
            document.getElementById('previousTournamentPlayers').innerHTML = '';
            return;
        }
        
        fetch(`/api/tournaments/${tournamentId}/players`)
            .then(response => response.json())
            .then(data => {
                var html = '<div style="display: flex; flex-direction: column; gap: 0.5rem;">';
                data.forEach(player => {
                    html += `
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: #f9f9f9; border-radius: 4px;">
                            <div>
                                <strong>${player.initials}</strong>
                                <span style="color: #999; margin-left: 1rem;">${player.name || '-'}</span>
                            </div>
                            <button type="button" onclick="addPlayerFromPrevious('${player.userId}', '${player.initials}', '${player.name || ''}')" 
                                    style="background: #4caf50; color: white; border: none; border-radius: 4px; padding: 0.25rem 0.75rem; cursor: pointer;">
                                + Add
                            </button>
                        </div>
                    `;
                });
                html += '</div>';
                document.getElementById('previousTournamentPlayers').innerHTML = html;
            })
            .catch(error => {
                console.error('Error loading players:', error);
                document.getElementById('previousTournamentPlayers').innerHTML = '<p style="color: #f44336;">Error loading players</p>';
            });
    }
    
    function addPlayerFromPrevious(userId, initials, name) {
        // For now, redirect to add player with pre-filled data
        window.location.href = `/Tournaments/@Model.Tournament.Id/Players?addFromPrevious=true&userId=${userId}&initials=${encodeURIComponent(initials)}&name=${encodeURIComponent(name)}`;
    }
</script>
