@page
@model MatchDetailModel
@{
    ViewData["Title"] = "Match Details - @Model.Tournament?.Name";
}

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h2 class="card-title" style="margin: 0;">Match #@Model.Match?.Order</h2>
            <div style="color: #666; font-size: 0.875rem; margin-top: 0.25rem;">
                @Model.Match?.State • @(Model.Match?.CompletedAt?.ToShortDateString() ?? Model.Match?.CreatedAt.ToShortDateString())
            </div>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a asp-page="/Tournaments/Matches" asp-route-id="@Model.Tournament?.Id" class="btn btn-secondary">Back to Matches</a>
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-page="/Tournaments/CreateMatch" asp-route-tournamentId="@Model.Tournament?.Id" asp-route-matchId="@Model.Match?.Id"
                   class="btn btn-warning">Edit</a>
            }
        </div>
    </div>
</div>

<div class="flex-row" style="gap: 2rem;">
    <!-- Match Result Card -->
    <div class="main-content">
        <div class="card">
            <h3 class="card-title">Match Result</h3>
            
            <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; align-items: center; margin: 2rem 0;">
                <!-- Team 1 -->
                <div style="text-align: center;">
                    <div style="font-size: 2rem; color: #f44336; margin-bottom: 0.5rem;">🔴</div>
                    <div style="font-size: 1.25rem; font-weight: bold; margin-bottom: 0.5rem;">
                        @GetTeamName(0)
                    </div>
                    <div style="font-size: 1rem; color: #666;">
                        @string.Join(" + ", GetTeamPlayers(0).Select(p => p.User.UserName))
                    </div>
                </div>
                
                <!-- Score -->
                <div style="text-align: center; font-size: 3rem; font-weight: bold;">
                    @GetTeamScore(0) - @GetTeamScore(1)
                </div>
                
                <!-- Team 2 -->
                <div style="text-align: center;">
                    <div style="font-size: 2rem; color: #2196f3; margin-bottom: 0.5rem;">🔵</div>
                    <div style="font-size: 1.25rem; font-weight: bold; margin-bottom: 0.5rem;">
                        @GetTeamName(1)
                    </div>
                    <div style="font-size: 1rem; color: #666;">
                        @string.Join(" + ", GetTeamPlayers(1).Select(p => p.User.UserName))
                    </div>
                </div>
            </div>
            
            @if (Model.Match?.State == MatchState.Done)
            {
                <div style="text-align: center; margin-top: 1rem;">
                    <span class="badge badge-success" style="font-size: 1.25rem; padding: 0.75rem 2rem;">
                        Match Completed
                    </span>
                </div>
            }
        </div>
        
        <!-- Player Impact Card -->
        @if (Model.Match?.State == MatchState.Done)
        {
            <div class="card" style="margin-top: 1rem;">
                <h3 class="card-title">Player Score Changes</h3>
                
                <table class="table">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Previous Score</th>
                            <th>Change</th>
                            <th>New Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in Model.Match?.Teams ?? new List<TournamentTeam>())
                        {
                            foreach (var player in team.Players)
                            {
                                <tr>
                                    <td>@player.User.UserName</td>
                                    <td>@(player.Score - player.ScoreDiff).ToString("N2")</td>
                                    <td class="@(player.ScoreDiff >= 0 ? "score-diff-positive" : "score-diff-negative")">
                                        @(player.ScoreDiff >= 0 ? "+" : "")@player.ScoreDiff.ToString("N2")
                                    </td>
                                    <td>@player.Score.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="card">
            <h3 class="card-title">Match Information</h3>
            <table class="table" style="font-size: 0.875rem;">
                <tr>
                    <td>Tournament:</td>
                    <td><a asp-page="/Tournaments/Detail" asp-route-id="@Model.Tournament?.Id">@Model.Tournament?.Name</a></td>
                </tr>
                <tr>
                    <td>Order:</td>
                    <td>@Model.Match?.Order</td>
                </tr>
                <tr>
                    <td>Status:</td>
                    <td>
                        @switch (Model.Match?.State)
                        {
                            case MatchState.Planned:
                                <span class="badge badge-secondary">Planned</span>
                                break;
                            case MatchState.Done:
                                <span class="badge badge-success">Done</span>
                                break;
                            case MatchState.Cancelled:
                                <span class="badge badge-danger">Cancelled</span>
                                break;
                        }
                    </td>
                </tr>
                <tr>
                    <td>Created:</td>
                    <td>@Model.Match?.CreatedAt.ToShortDateString()</td>
                </tr>
                @if (Model.Match != null && Model.Match.CompletedAt.HasValue)
                {
                    <tr>
                        <td>Completed:</td>
                        <td>@Model.Match?.CompletedAt?.ToShortDateString()</td>
                    </tr>
                }
            </table>
        </div>
        
        @if (Model.Match?.State == MatchState.Planned && User.Identity.IsAuthenticated)
        {
            <div class="card" style="margin-top: 1rem;">
                <h3 class="card-title">Actions</h3>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <a asp-page="/Tournaments/CreateMatch" asp-route-tournamentId="@Model.Tournament?.Id" asp-route-matchId="@Model.Match?.Id"
                       class="btn btn-primary" style="text-align: center;">
                        Edit Match
                    </a>
                    <form method="post" action="/Tournaments/Matches">
                        <input type="hidden" name="tournamentId" value="@Model.Tournament?.Id" />
                        <input type="hidden" name="matchId" value="@Model.Match?.Id" />
                        <button type="submit" class="btn btn-danger" style="width: 100%;">
                            Cancel Match
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetTeamName(int teamIndex)
    {
        var teams = Model.GetTeams();
        if (teams.Count > teamIndex)
        {
            return teams[teamIndex].Name;
        }
        return "Team " + (teamIndex + 1);
    }
    
    List<TournamentPlayer> GetTeamPlayers(int teamIndex)
    {
        var teams = Model.GetTeams();
        if (teams.Count > teamIndex)
        {
            return teams[teamIndex].Players?.ToList() ?? new List<TournamentPlayer>();
        }
        return new List<TournamentPlayer>();
    }
    
    int GetTeamScore(int teamIndex)
    {
        var results = Model.GetResults();
        if (results.Count > teamIndex)
        {
            return results[teamIndex].GoalsWon;
        }
        return 0;
    }
}
