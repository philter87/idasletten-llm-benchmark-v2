@page
@model CreateModel
@{
    ViewData["Title"] = "Create Tournament";
}

<div class="card">
    <h2 class="card-title">Create New Tournament</h2>
    
    <form method="post" style="max-width: 500px;">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;"></div>
        
        <div style="margin-bottom: 1rem;">
            <label asp-for="Tournament.Name" class="form-label">Tournament Name *</label>
            <input asp-for="Tournament.Name" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" />
            <span asp-validation-for="Tournament.Name" class="text-danger"></span>
        </div>
        
        <div style="margin-bottom: 1rem;">
            <label asp-for="Tournament.MaxPlayerCount" class="form-label">Maximum Players (optional)</label>
            <input asp-for="Tournament.MaxPlayerCount" type="number" class="form-control" 
                   style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" 
                   placeholder="Leave empty for no limit" />
            <span asp-validation-for="Tournament.MaxPlayerCount" class="text-danger"></span>
        </div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div>
                <label asp-for="Tournament.TeamSize" class="form-label">Players per Team</label>
                <input asp-for="Tournament.TeamSize" type="number" min="1" max="10" class="form-control" 
                       style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" />
                <span asp-validation-for="Tournament.TeamSize" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Tournament.PointsToWin" class="form-label">Points to Win</label>
                <input asp-for="Tournament.PointsToWin" type="number" min="1" max="20" class="form-control" 
                       style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" />
                <span asp-validation-for="Tournament.PointsToWin" class="text-danger"></span>
            </div>
        </div>
        
        <div style="margin-bottom: 1rem;">
            <label asp-for="Tournament.ScoreSystem" class="form-label">Scoring System</label>
            <select asp-for="Tournament.ScoreSystem" class="form-control" 
                    style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;" 
                    asp-items="Html.GetEnumSelectList<ScoreSystem>()">
            </select>
            <span asp-validation-for="Tournament.ScoreSystem" class="text-danger"></span>
            <small style="color: #666; display: block; margin-top: 0.25rem;">
                @GetScoringSystemDescription(Model.Tournament.ScoreSystem)
            </small>
        </div>
        
        <div style="margin-bottom: 1.5rem;">
            <label class="form-label" style="display: flex; align-items: center; gap: 0.5rem;">
                <input asp-for="Tournament.IsPublic" style="width: auto;" />
                <span>Public Tournament (visible to all users)</span>
            </label>
        </div>
        
        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <button type="submit" name="action" value="create" class="btn btn-primary">Create Tournament</button>
            <button type="submit" name="action" value="createAndPlan" class="btn btn-secondary">Create and Plan Matches</button>
            <a asp-page="/Tournaments" class="btn btn-secondary" style="color: #666;">Cancel</a>
        </div>
    </form>
</div>

<div class="card" style="margin-top: 1rem;">
    <h3 class="card-title">Scoring Systems Explained</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem;">
        <div class="card" style="box-shadow: none; border: none; padding: 0;">
            <h4 style="color: #1a237e; margin: 0 0 0.5rem 0;">TrueSkill</h4>
            <p style="font-size: 0.875rem; color: #666; margin: 0;">
                Microsoft's ranking system that accounts for uncertainty in player skills.
            </p>
        </div>
        <div class="card" style="box-shadow: none; border: none; padding: 0;">
            <h4 style="color: #1a237e; margin: 0 0 0.5rem 0;">Elo</h4>
            <p style="font-size: 0.875rem; color: #666; margin: 0;">
                Classic rating system where points are exchanged based on expected outcomes.
            </p>
        </div>
        <div class="card" style="box-shadow: none; border: none; padding: 0;">
            <h4 style="color: #1a237e; margin: 0 0 0.5rem 0;">Lives</h4>
            <p style="font-size: 0.875rem; color: #666; margin: 0;">
                Each player has a set number of lives. Losing a match costs a life.
            </p>
        </div>
        <div class="card" style="box-shadow: none; border: none; padding: 0;">
            <h4 style="color: #1a237e; margin: 0 0 0.5rem 0;">WinCount</h4>
            <p style="font-size: 0.875rem; color: #666; margin: 0;">
                Simple count of wins. Tie-breakers use goal difference.
            </p>
        </div>
    </div>
</div>

@functions {
    string GetScoringSystemDescription(ScoreSystem scoreSystem)
    {
        return scoreSystem switch
        {
            ScoreSystem.TrueSkill => "Microsoft's TrueSkill algorithm with aggressive parameters",
            ScoreSystem.Elo => "Classic Elo rating system",
            ScoreSystem.Lives => "Players lose lives on defeats",
            ScoreSystem.WinCount => "Simple win counting with goal difference tie-breaker",
            _ => ""
        };
    }
}
