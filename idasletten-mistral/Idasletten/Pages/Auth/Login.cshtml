@page
@model LoginModel
@{
    ViewData["Title"] = "Log ind - Idasletten";
}

<div class="bc-grid">
    <div class="bc-grid__item bc-grid__item--1-2">
        <div class="tournament-card">
            <h2>Log ind</h2>
            
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="bc-alert bc-alert--danger">@Model.ErrorMessage</div>
            }

            @if (Model.ShowTestUserLogin)
            {
                <div style="margin-bottom: 1rem;">
                    <h3>Test bruger</h3>
                    <p>Log ind med test bruger (kun til udvikling)</p>
                    <form method="post" class="bc-form">
                        <input type="hidden" name="useTestUser" value="true" />
                        <div class="bc-form-group">
                            <label for="Email">Email</label>
                            <input type="text" id="Email" name="Email" class="bc-form-input" 
                                   value="test@idasletten.local" required />
                        </div>
                        <div class="bc-form-group">
                            <label for="Password">Adgangskode</label>
                            <input type="password" id="Password" name="Password" class="bc-form-input" 
                                   value="Test123!" required />
                        </div>
                        <button type="submit" class="bc-btn bc-btn--primary" style="width: 100%;">
                            <i class="fas fa-user"></i> Log ind som test bruger
                        </button>
                    </form>
                </div>
            }

            <div style="margin-top: 2rem; text-align: center;">
                <p><a href="/">Gå tilbage til forsiden</a></p>
            </div>
        </div>
    </div>
</div>
