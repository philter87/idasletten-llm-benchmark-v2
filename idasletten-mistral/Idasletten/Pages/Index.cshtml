@page
@model IndexModel
@{
    ViewData["Title"] = "Idasletten - Bordfodbold Turneringer";
}

<div class="hero fade-in">
    <h1>Velkommen til Idasletten</h1>
    <p>
        <em>Idasletten (Iðavöllr)</em> findes i nordisk mytologi lige uden for Valhals porte. 
        Det er her vikingerne som er døde i krig udkæmper deres drabelige slag hver dag, 
        som øvelse til Ragnarok. Hver aften er Idasletten rød af blod.
    </p>
</div>

<div class="bc-grid">
    <div class="bc-grid__item bc-grid__item--2-3">
        <h2>Offentlige turneringer</h2>
        <p>Vælg en turnering for at se scoreboard og kampe.</p>
        
        @if (Model.PublicTournaments.Any())
        {
            <div class="tournament-list">
                @foreach (var tournament in Model.PublicTournaments)
                {
                    <div class="tournament-card">
                        <h3>@tournament.Name</h3>
                        <p>
                            <strong>Spillere:</strong> @tournament.Players.Count 
                            | <strong>Holdstørrelse:</strong> @tournament.TeamSize 
                            | <strong>Point til sejr:</strong> @tournament.PointsToWin
                            | <strong>Scoring:</strong> @tournament.ScoreSystem
                        </p>
                        <p>
                            <span class="match-state-@(tournament.IsArchived ? "cancelled" : "planned")">
                                @(tournament.IsArchived ? "Afsluttet" : "Aktiv")
                            </span>
                        </p>
                        <a href="/tournaments/@tournament.Id" class="bc-btn bc-btn--primary">Vis turnering</a>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="bc-alert bc-alert--info">Der er ingen offentlige turneringer endnu.</p>
        }
    </div>
    
    <div class="bc-grid__item bc-grid__item--1-3">
        <div class="tournament-card">
            <h3>Historiske turneringer</h3>
            <p>Se alle turneringer, inklusiv private og afsluttede.</p>
            <a href="/tournaments" class="bc-btn bc-btn--secondary">Se alle turneringer</a>
        </div>
        
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="tournament-card">
                <h3>Opret turnering</h3>
                <p>Log ind for at oprette en ny turnering.</p>
                <a href="/login" class="bc-btn bc-btn--primary">Log ind</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Simple fade-in animation on page load
        document.addEventListener('DOMContentLoaded', function() {
            const elements = document.querySelectorAll('.fade-in');
            elements.forEach((el, index) => {
                setTimeout(() => {
                    el.style.opacity = '1';
                }, index * 100);
            });
        });
    </script>
}
